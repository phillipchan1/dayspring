---
// /start — the Entrance redirect. Every trial door on the site (Hero,
// PricingTiers, Footer) and any ad creative that lands here directly points
// at this page. It exists to do three things, in order, before handing off
// to the app:
//   1. Preserve whatever UTMs (or fbclid/gclid) arrived on the query string.
//   2. Fire the client-side conversion signals a redirect straight to the app
//      would lose — Meta's StartTrial pixel, PostHog's start_trial_clicked,
//      and (when PUBLIC_GADS_START_TRIAL_SEND_TO is set) a Google Ads
//      conversion. The Google hit waits on gtag's event_callback (gtag.js is
//      large enough that a fixed 400ms often navigates away first); a 1200ms
//      fallback keeps the visitor from getting stuck.
//   3. Send the visitor on to sign-in, where first sign-in grants
//      14-day trial with no card (api/profile/ensure.ts in the app repo).
//
// Static site (astro.config.mjs: output "static"), so none of this can happen
// server-side — the query string only exists in the browser. The visible copy
// and manual link below are the no-JS / slow-JS fallback; noscript users still
// get where they're going, just without a firing pixel.
import Base from "../layouts/Base.astro";
import { APP_URL } from "../content/site";
---

<Base
  title="Almost there"
  description="Taking you to Dayspring — your 14-day trial starts today."
  path="/start"
  footer="minimal"
  noindex
>
  <section class="start">
    <div class="card">
      <p class="eyebrow mono">Dayspring</p>
      <h1>Opening Dayspring…</h1>
      <p class="sub">Your 14-day trial starts today. Cancel anytime.</p>
      <a href={APP_URL} class="btn btn-primary" data-continue>
        Continue to Dayspring →
      </a>
      <noscript>
        <p class="noscript-note">
          JavaScript is off, so we can't carry this along automatically —
          tap the button above.
        </p>
      </noscript>
    </div>
  </section>
</Base>

<style>
  .start {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 140px 20px 80px;
  }
  .card {
    text-align: center;
    max-width: 420px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 18px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4.4vw, 38px);
    letter-spacing: -0.6px;
    margin: 0 0 12px;
  }
  .sub {
    color: var(--paper-dim);
    font-weight: 300;
    font-size: 16px;
    margin: 0 0 32px;
  }
  .noscript-note {
    margin-top: 18px;
    font-size: 13px;
    color: var(--muted);
  }
</style>

<script>
  import { handoffAfterStartTrialConversion } from "../lib/googleAds";
  import { trackSite } from "../lib/siteAnalytics";
  import { trackStartTrial } from "../lib/metaPixel";
  import { APP_URL } from "../content/site";

  const continueLink = document.querySelector<HTMLAnchorElement>("[data-continue]");

  // Preserve whatever arrived on our own query string onto the app URL — not
  // consumed there yet, but there for a future attribution join rather than
  // dropped on the floor. See docs/product/GROWTH_PULSE.md.
  const search = window.location.search;
  const target = search ? `${APP_URL}/${search}` : `${APP_URL}/`;
  if (continueLink) continueLink.href = target;

  trackSite("start_trial_clicked");
  trackStartTrial();
  // gtag.js is ~438KB; event_callback fires once the conversion is queued for
  // the network. Fallback is 1200ms so a hung tag never leaves the visitor here.
  handoffAfterStartTrialConversion(() => {
    window.location.replace(target);
  });
</script>
