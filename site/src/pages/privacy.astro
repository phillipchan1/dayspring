---
import Base from "../layouts/Base.astro";
import SectionReveal from "../components/SectionReveal.astro";
import DawnGlow from "../components/DawnGlow.astro";
import { privacyPage as p } from "../content/privacy";
---

<Base
  title="Privacy"
  description="Privacy as stewardship, not a feature checkbox. The plain truth about how Dayspring holds your writing in confidence — reassuring and true."
  path="/privacy"
>
  <article class="privacy">
    <header class="p-head">
      <div class="glow-host"><DawnGlow variant="bloom" intensity={0.5} /></div>
      <SectionReveal>
        <p class="eyebrow mono">{p.eyebrow}</p>
        <h1 set:html={p.heading} />
        <p class="lead">{p.lead}</p>
      </SectionReveal>
    </header>

    {/* the promises — all true */}
    <section class="promises wrap">
      {
        p.promises.map((promise, i) => (
          <SectionReveal delay={i * 50}>
            <div class="promise">
            <span class="check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 13l4 4L19 7"
                />
              </svg>
            </span>
            <div>
              <h2>{promise.title}</h2>
              <p>{promise.body}</p>
            </div>
            </div>
          </SectionReveal>
        ))
      }
    </section>

    {/* the honest distinction */}
    <section class="wrap">
      <SectionReveal>
        <div class="straight">
          <h2>{p.straight.title}</h2>
          <p set:html={p.straight.body} />
        </div>
        <p class="faith-line">{p.line}</p>
      </SectionReveal>
    </section>

    <section class="wrap">
      <SectionReveal>
        <div class="cta-wrap">
          <a href={p.cta.href} class="btn btn-ghost">{p.cta.label}</a>
        </div>
      </SectionReveal>
    </section>
  </article>
</Base>

<style>
  .privacy {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .p-head {
    position: relative;
    text-align: center;
    padding: 200px 0 64px;
  }
  .glow-host {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .p-head .eyebrow {
    font-size: 12.5px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 26px;
    position: relative;
  }
  .p-head h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.1;
    letter-spacing: -1px;
    max-width: 22ch;
    margin: 0 auto 22px;
    position: relative;
  }
  .p-head h1 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .p-head .lead {
    font-size: 18px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.62;
    max-width: 54ch;
    margin: 0 auto;
    position: relative;
  }

  /* promises */
  .promises {
    display: grid;
    gap: 28px;
    padding: 20px 0 10px;
  }
  .promise {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .promise .check {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--dawn-1);
    border: 1px solid rgba(243, 189, 118, 0.3);
    margin-top: 2px;
  }
  .promise h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 20px;
    color: var(--paper);
    margin-bottom: 5px;
  }
  .promise p {
    font-size: 16.5px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.62;
  }

  /* the honest distinction */
  .straight {
    margin: 50px 0;
    padding: 28px 30px;
    border-left: 2px solid rgba(243, 189, 118, 0.4);
  }
  .straight h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 21px;
    color: var(--paper);
    margin-bottom: 10px;
  }
  .straight p {
    font-size: 17px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.66;
  }
  .straight p :global(em) {
    font-style: italic;
    color: var(--paper);
  }
  .faith-line {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(20px, 2.6vw, 27px);
    color: var(--gold);
    text-align: center;
    margin: 36px 0 0;
  }

  .cta-wrap {
    text-align: center;
    margin: 54px 0;
  }

  @media (max-width: 600px) {
    .p-head {
      padding: 150px 0 48px;
    }
  }
</style>
