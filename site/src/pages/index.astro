---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionReveal from "../components/SectionReveal.astro";
import SlashShowcase from "../components/SlashShowcase.astro";
import RitualsGlimpse from "../components/RitualsGlimpse.astro";
import AscentGlimpse from "../components/AscentGlimpse.astro";
import ScriptureTeaser from "../components/ScriptureTeaser.astro";
import AltarMock from "../components/AltarMock.astro";
import PricingTiers from "../components/PricingTiers.astro";
import { pricingHonest } from "../content/site";
import {
  hero,
  problem,
  editor,
  slashCommands,
  practices,
  bridge,
  becoming,
  scripture,
  lookingBack,
  altar,
  bringHistory,
  privacy,
  pricing,
} from "../content/home";
---

<Base
  title="A journal built for spiritual growth"
  description="Dayspring is a journal built for spiritual growth — scripture, prayer, and contemplative practice right on the page, and a year of your own words that shows you who you're becoming."
  path="/"
>
  <Hero
    eyebrow={hero.eyebrow}
    lines={hero.lines}
    sub={hero.sub}
    verse={hero.verse}
    primary={hero.primary}
    ghost={hero.ghost}
    mockCaption={hero.mockCaption}
    appMock={hero.appMock}
  />

  {/* the wedge — one line that names the category */}
  <section class="wedge">
    <SectionReveal class="wrap">
      <p>
        {problem.before}<span class="hl">{problem.highlight}</span>{problem.after}
      </p>
    </SectionReveal>
  </section>

  {/* ===================== ACT I — WRITE ===================== */}

  {/* slash commands — the signature, leads Act I */}
  <section class="slash-sec">
    <SectionReveal class="wrap slash-head">
      <div class="act-eyebrow mono">Ⅰ · The practice</div>
      <div class="tag">{slashCommands.tag}</div>
      <h2 set:html={slashCommands.heading} />
      <p class="lead" set:html={slashCommands.lead} />
    </SectionReveal>
    <SectionReveal class="wrap">
      <SlashShowcase commands={slashCommands.commands} demo={slashCommands.demo} />
    </SectionReveal>
    <SectionReveal class="wrap">
      <p class="slash-bridge">{slashCommands.bridge}</p>
    </SectionReveal>
  </section>

  {/* rituals — split, visual left */}
  <section class="feature rituals-sec">
    <div class="wrap">
      <div class="grid grid-vl">
        <SectionReveal class="col-visual">
          <RitualsGlimpse rituals={practices.rituals} foot={practices.foot} />
        </SectionReveal>
        <SectionReveal class="col-copy">
          <div class="tag">{practices.tag}</div>
          <h2 set:html={practices.heading} />
          <p class="lead" set:html={practices.lead} />
        </SectionReveal>
      </div>
    </div>
  </section>

  {/* the editor — a compact supporting beat (the page itself is a joy) */}
  <section class="craft-sec">
    <SectionReveal class="wrap craft-head">
      <div class="tag">{editor.tag}</div>
      <h2 set:html={editor.heading} />
      <p class="lead">{editor.lead}</p>
    </SectionReveal>
    <SectionReveal class="wrap">
      <ul class="craft-row">
        {
          editor.highlights.map((h) => (
            <li>
              <span class="c-title">{h.title}</span>
              <span class="c-body">{h.body}</span>
            </li>
          ))
        }
      </ul>
    </SectionReveal>
  </section>

  {/* the bridge — a quiet band, the turn into the long view */}
  <section class="bridge-band">
    <SectionReveal class="wrap">
      <p set:html={bridge.line} />
    </SectionReveal>
  </section>

  {/* ===================== ACT II — RETURN ===================== */}

  {/* becoming — Act II banner */}
  <section class="becoming-sec">
    <SectionReveal class="wrap">
      <div class="act-eyebrow mono">Ⅱ · {becoming.tag}</div>
      <h2 set:html={becoming.heading} />
      <p class="lead">{becoming.lead}</p>
    </SectionReveal>
  </section>

  {/* the Lamp — split, visual right */}
  <section class="feature scripture-sec">
    <div class="wrap">
      <div class="grid grid-vr">
        <SectionReveal class="col-copy">
          <div class="tag">{scripture.tag}</div>
          <h2 set:html={scripture.heading} />
          <p class="lead">{scripture.lead}</p>
        </SectionReveal>
        <SectionReveal class="col-visual">
          <ScriptureTeaser preview />
        </SectionReveal>
      </div>
    </div>
  </section>

  {/* the Ascent — centered stage */}
  <section class="ascent-sec">
    <SectionReveal class="wrap ascent-head">
      <div class="tag">{lookingBack.tag}</div>
      <h2 set:html={lookingBack.heading} />
      <p class="lead">{lookingBack.lead}</p>
    </SectionReveal>
    <SectionReveal class="wrap ascent-stage">
      <AscentGlimpse
        altitudes={lookingBack.glimpse.altitudes}
        activeAlt={lookingBack.glimpse.activeAlt}
        activeLabel={lookingBack.glimpse.activeLabel}
        oneLine={lookingBack.glimpse.oneLine}
        verseRef={lookingBack.glimpse.verseRef}
        lenses={lookingBack.lenses}
        hint={lookingBack.glimpse.hint}
      />
      <p class="ascent-caption">{lookingBack.caption}</p>
    </SectionReveal>
  </section>

  {/* the Altar — split, visual left (now shipped) */}
  <section class="feature altar-sec">
    <div class="wrap">
      <div class="grid grid-vl">
        <SectionReveal class="col-visual">
          <AltarMock
            subtitle={altar.mock.subtitle}
            intro={altar.mock.intro}
            groups={altar.mock.groups}
            note={altar.mock.note}
          />
        </SectionReveal>
        <SectionReveal class="col-copy">
          <div class="tag">{altar.tag}</div>
          <h2 set:html={altar.heading} />
          <p class="lead">{altar.lead}</p>
        </SectionReveal>
      </div>
    </div>
  </section>

  {/* ===================== ACT III — START ===================== */}

  {/* bring your history — centered card */}
  <section class="import-sec">
    <SectionReveal class="wrap import-head">
      <div class="tag">{bringHistory.tag}</div>
      <h2 set:html={bringHistory.heading} />
      <p class="lead">{bringHistory.lead}</p>
    </SectionReveal>
    <SectionReveal class="wrap">
      <div class="import-card">
        <div class="sources">
          {bringHistory.mock.sources.map((s) => <span class="source mono">{s}</span>)}
        </div>
        <div class="import-flow" aria-hidden="true">↓</div>
        <div class="imported mono">{bringHistory.mock.imported}</div>
        <div class="ready">{bringHistory.mock.ready}</div>
      </div>
    </SectionReveal>
  </section>

  {/* privacy as stewardship — near-bare, centered */}
  <section class="privacy-sec">
    <SectionReveal class="wrap">
      <div class="tag">{privacy.tag}</div>
      <h2 set:html={privacy.heading} />
      <p class="body">{privacy.body}</p>
      <p class="line">{privacy.line}</p>
    </SectionReveal>
  </section>

  {/* pricing */}
  <section class="pricing">
    <div class="wrap">
      <SectionReveal class="head">
        <div class="tag">{pricing.tag}</div>
        <h2 set:html={pricing.heading} />
        <p>{pricing.lead}</p>
      </SectionReveal>
      <SectionReveal>
        <PricingTiers />
      </SectionReveal>
      <SectionReveal as="p" class="honest">{pricingHonest}</SectionReveal>
      <SectionReveal as="p" class="price-more">
        <a href="/features#everything">50+ little details in every plan — see them all →</a>
      </SectionReveal>
    </div>
  </section>
</Base>

<style>
  /* ===== shared section primitives ===== */
  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 18px;
  }
  .act-eyebrow {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 26px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(32px, 4.8vw, 58px);
    letter-spacing: -1px;
    line-height: 1.04;
    margin: 0 0 18px;
  }
  h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .lead {
    font-size: 19px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.55;
    max-width: 50ch;
  }
  .lead :global(em) {
    font-style: normal;
    font-family: var(--font-mono);
    color: var(--gold);
  }

  /* ===== the wedge ===== */
  .wedge {
    padding: 130px 0 110px;
    text-align: center;
  }
  .wedge :global(p) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(26px, 4vw, 46px);
    line-height: 1.3;
    max-width: 22ch;
    margin: 0 auto;
    letter-spacing: -0.5px;
  }
  .wedge :global(.hl) {
    color: var(--dawn-2);
    font-style: italic;
  }

  /* ===== feature (split) layout ===== */
  .feature {
    padding: 70px 0 100px;
  }
  .feature .grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 64px;
    align-items: center;
  }
  .grid-vl {
    grid-template-columns: 1.05fr 1fr;
  }
  .feature .col-copy h2 {
    max-width: 16ch;
  }
  .scripture-sec .grid {
    grid-template-columns: 0.9fr 1.1fr;
  }

  /* ===== the editor — compact supporting craft strip ===== */
  .craft-sec {
    padding: 10px 0 100px;
  }
  .craft-sec :global(.craft-head) {
    text-align: center;
    margin-bottom: 36px;
  }
  .craft-sec :global(.craft-head) h2 {
    font-size: clamp(28px, 3.6vw, 44px);
    max-width: 18ch;
    margin-left: auto;
    margin-right: auto;
  }
  .craft-sec :global(.craft-head) .lead {
    max-width: 50ch;
    margin: 0 auto;
  }
  .craft-row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 920px;
    margin: 0 auto;
  }
  .craft-row li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 16px;
    border-left: 2px solid var(--border-strong);
  }
  .c-title {
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--paper);
  }
  .c-body {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--paper-dim);
    font-weight: 300;
  }
  @media (max-width: 760px) {
    .craft-row {
      grid-template-columns: 1fr;
      max-width: 440px;
      gap: 20px;
    }
  }

  /* ===== slash showcase (full-width) ===== */
  .slash-sec {
    padding: 30px 0 100px;
  }
  .slash-sec :global(.slash-head) {
    text-align: center;
    margin-bottom: 44px;
  }
  .slash-sec :global(.slash-head) h2 {
    max-width: 20ch;
    margin-left: auto;
    margin-right: auto;
  }
  .slash-sec :global(.slash-head) .lead {
    max-width: 56ch;
    margin: 0 auto;
  }
  .slash-bridge {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(17px, 2vw, 21px);
    color: var(--muted);
    text-align: center;
    max-width: 50ch;
    margin: 48px auto 0;
    line-height: 1.5;
  }

  /* ===== the bridge band ===== */
  .bridge-band {
    padding: 96px 0;
    text-align: center;
    background:
      radial-gradient(
        ellipse at center,
        var(--accent-glow) 0%,
        transparent 70%
      );
  }
  .bridge-band :global(p) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(26px, 3.6vw, 44px);
    line-height: 1.25;
    letter-spacing: -0.5px;
    max-width: 24ch;
    margin: 0 auto;
  }
  .bridge-band :global(em) {
    font-style: italic;
    color: var(--gold);
  }

  /* ===== becoming (Act II banner) ===== */
  .becoming-sec {
    padding: 60px 0 40px;
    text-align: center;
  }
  .becoming-sec h2 {
    font-size: clamp(36px, 5.4vw, 64px);
    max-width: 16ch;
    margin-left: auto;
    margin-right: auto;
  }
  .becoming-sec .lead {
    max-width: 54ch;
    margin: 0 auto;
  }

  /* ===== ascent (centered stage) ===== */
  .ascent-sec {
    padding: 70px 0 110px;
  }
  .ascent-sec :global(.ascent-head) {
    text-align: center;
    margin-bottom: 44px;
  }
  .ascent-sec :global(.ascent-head) h2 {
    max-width: 18ch;
    margin-left: auto;
    margin-right: auto;
  }
  .ascent-sec :global(.ascent-head) .lead {
    max-width: 46ch;
    margin: 0 auto;
  }
  .ascent-sec :global(.ascent-stage) {
    max-width: 560px;
    margin: 0 auto;
  }
  .ascent-caption {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(14px, 1.6vw, 17px);
    color: var(--muted);
    text-align: center;
    max-width: 44ch;
    margin: 24px auto 0;
    line-height: 1.5;
  }

  /* ===== import (centered card) ===== */
  .import-sec {
    padding: 30px 0 110px;
  }
  .import-sec :global(.import-head) {
    text-align: center;
    margin-bottom: 36px;
  }
  .import-sec :global(.import-head) h2 {
    max-width: 18ch;
    margin-left: auto;
    margin-right: auto;
  }
  .import-sec :global(.import-head) .lead {
    max-width: 52ch;
    margin: 0 auto;
  }
  .import-card {
    max-width: 460px;
    margin: 0 auto;
    background: var(--card-grad);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 32px;
    text-align: center;
    box-shadow:
      0 40px 80px -50px var(--shadow),
      0 0 60px -30px var(--accent-glow);
  }
  .import-card .sources {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .import-card .source {
    font-size: 12px;
    letter-spacing: 0.3px;
    color: var(--paper-dim);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 7px 14px;
  }
  .import-card .import-flow {
    color: var(--dawn-1);
    font-size: 20px;
    margin: 16px 0 14px;
  }
  .import-card .imported {
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 12px;
  }
  .import-card .ready {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: 21px;
    color: var(--paper);
  }

  /* ===== privacy ===== */
  .privacy-sec {
    padding: 20px 0 110px;
    text-align: center;
  }
  .privacy-sec h2 {
    max-width: 20ch;
    margin: 0 auto 24px;
    font-size: clamp(28px, 4.4vw, 50px);
    line-height: 1.14;
  }
  .privacy-sec .body {
    font-size: 18px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.62;
    max-width: 52ch;
    margin: 0 auto 28px;
  }
  .privacy-sec .line {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(22px, 3vw, 32px);
    letter-spacing: -0.3px;
    color: var(--gold);
    max-width: 24ch;
    margin: 0 auto;
  }

  /* ===== pricing ===== */
  .pricing {
    padding: 40px 0 120px;
  }
  .pricing :global(.head) {
    text-align: center;
    margin-bottom: 56px;
  }
  .pricing h2 {
    font-size: clamp(32px, 5vw, 56px);
    margin-bottom: 14px;
  }
  .pricing :global(.head) p {
    color: var(--paper-dim);
    font-weight: 300;
    font-size: 18px;
    max-width: 48ch;
    margin: 0 auto;
  }
  .pricing :global(.honest) {
    text-align: center;
    margin-top: 36px;
    font-style: italic;
    color: var(--muted);
    font-size: 15px;
  }
  .pricing :global(.price-more) {
    text-align: center;
    margin-top: 14px;
  }
  .pricing :global(.price-more) a {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.2px;
    color: var(--dawn-1);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s;
  }
  .pricing :global(.price-more) a:hover {
    border-bottom-color: var(--dawn-1);
  }

  /* ===== responsive ===== */
  @media (max-width: 860px) {
    .feature .grid,
    .feature .grid-vl,
    .scripture-sec .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    /* on stack, always show copy before its visual */
    .feature .col-visual {
      order: 2;
    }
    .feature .col-copy {
      order: 1;
    }
    .feature .col-copy h2 {
      max-width: none;
    }
  }
  @media (max-width: 640px) {
    .feature {
      padding: 50px 0 70px;
    }
    .wedge {
      padding: 90px 0 70px;
    }
    .bridge-band {
      padding: 70px 0;
    }
  }
</style>
