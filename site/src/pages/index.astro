---
// The home page — "night to first light" (2026-11 redesign).
//
// One continuous sunrise, told point first. The first screen carries the whole
// promise (tagline, who it's for, the download, and the product writing an
// entry on its own). Screen two is the whole story at a glance — Write, Find,
// See — with the one real beta voice. Then each part unfolds: Write and the
// rituals; forgetting as the turn into Remember; the pages, the Lamp, the
// Ascent, the Altar, bringing your history; the promises; the plan.
//
// Scroll budget: only the wall, the Ascent, the Altar and forgetting scrub with
// scroll (each ≤ 3 screens). Demos play on their own while on screen, so
// nobody has to scroll to make meaning appear.
//
// Copy lives in content/landing.ts. Motion lives in each scene's script and
// shares one clock (lib/motion.ts). With prefers-reduced-motion, every scene
// shows its finished frame and the page reads top to bottom as plain content.
import Base from "../layouts/Base.astro";
import "../styles/landing.css";
import Hero from "../components/landing/Hero.astro";
import Forgetting from "../components/landing/Forgetting.astro";
import Overview from "../components/landing/Overview.astro";
import WriteScene from "../components/landing/WriteScene.astro";
import RitualsRail from "../components/landing/RitualsRail.astro";
import Voice from "../components/landing/Voice.astro";
import Wall from "../components/landing/Wall.astro";
import Lamp from "../components/landing/Lamp.astro";
import Ascent from "../components/landing/Ascent.astro";
import Altar from "../components/landing/Altar.astro";
import History from "../components/landing/History.astro";
import Promises from "../components/landing/Promises.astro";
import PricingTiers from "../components/PricingTiers.astro";
import SectionReveal from "../components/SectionReveal.astro";
import { pricingHonest } from "../content/site";
import { pricing, closing } from "../content/landing";
---

<Base
  title="A journal built for spiritual growth"
  description="A journal built for spiritual growth — scripture, prayer, and the old practices of the church right in the page you're writing, and everything you write kept, found again, and read back to you over the years."
  path="/"
  footerBig={closing.big}
>
  <Hero />
  <Overview />
  <Voice />

  <WriteScene />
  <RitualsRail />

  <Forgetting />
  <Wall />
  <Lamp />
  <Ascent />
  <Altar />
  <History />

  <Promises />

  <section class="plan" id="pricing" data-track="pricing" aria-labelledby="plan-h">
    <SectionReveal class="plan-head">
      <div class="kicker">{pricing.kicker}</div>
      <h2 id="plan-h" class="h2" set:html={pricing.heading} />
      <p class="body-l">{pricing.lead}</p>
    </SectionReveal>
    <SectionReveal class="plan-tiers">
      <PricingTiers />
    </SectionReveal>
    <SectionReveal as="p" class="plan-honest">{pricingHonest}</SectionReveal>
  </section>
</Base>

<script>
  // Entrance funnel, step one. See site/src/lib/siteAnalytics.ts.
  import { trackSite, trackSection } from "../lib/siteAnalytics";
  trackSite("landing_viewed");

  // Scroll depth: which sections people reach, once each.
  const seen = new Set<string>();
  const io = new IntersectionObserver(
    (entries) => {
      for (const en of entries) {
        const id = (en.target as HTMLElement).dataset.track;
        if (!en.isIntersecting || !id || seen.has(id)) continue;
        seen.add(id);
        trackSection(id);
        io.unobserve(en.target);
      }
    },
    // a band across the middle of the screen, so tall pinned scenes count too
    { rootMargin: "-45% 0px -45% 0px" },
  );
  document.querySelectorAll("[data-track]").forEach((el) => io.observe(el));
</script>

<style>
  .plan {
    padding: 10vh 24px 16vh;
  }
  .plan :global(.plan-head) {
    max-width: 760px;
    margin: 0 auto 60px;
    text-align: center;
  }
  .plan :global(.plan-head) .kicker {
    margin-bottom: 16px;
  }
  .plan :global(.plan-head) .h2 {
    margin-bottom: 20px;
  }
  .plan :global(.plan-tiers) {
    max-width: var(--maxw);
    margin: 0 auto;
  }
  .plan :global(.plan-honest) {
    text-align: center;
    margin-top: 36px;
    font-style: italic;
    color: var(--muted);
    font-size: 15px;
  }
</style>
