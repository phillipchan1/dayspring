---
// /features — everything in Dayspring, up close, in the home page's hand:
// the sky behind, a rising headline, a jump list, then one chapter per part
// (numbered, alternating, its live mock tilting up out of the page), and the
// exhaustive list last. Copy: content/features.ts (+ the home.ts mocks).
import Base from "../layouts/Base.astro";
import PageHero from "../components/landing/PageHero.astro";
import Split from "../components/landing/Split.astro";
import BibleSideBySide from "../components/landing/BibleSideBySide.astro";
import LockMock from "../components/landing/LockMock.astro";
import PracticeMock from "../components/PracticeMock.astro";
import AltarMock from "../components/AltarMock.astro";
import ScriptureTeaser from "../components/ScriptureTeaser.astro";
import LookingBackMock from "../components/LookingBackMock.astro";
import ProductShot from "../components/ProductShot.astro";
import VoicePicker from "../components/VoicePicker.astro";
import { featuresIntro, deepDives, everythingIntro, everything } from "../content/features";
import { lookingBack, altar, practices, pages } from "../content/home";

// "Everything you've written, and a way <em>back to it.</em>" → plain text +
// the accented words, for Split.
const parse = (html: string) => {
  const accent = [...html.matchAll(/<em>(.*?)<\/em>/g)].flatMap((m) => m[1].split(" "));
  return { text: html.replace(/<\/?em>/g, ""), accent };
};
const jump = deepDives.map((d) => ({ id: d.id, label: d.tag }));
---

<Base
  title="Features"
  description="Everything in Dayspring: slash commands and rituals in the sentence, Bible journaling side by side, every page on one wall, the Altar, the Lamp, the Ascent, and an app lock."
  path="/features"
  footerBig="Start today. Read the year later."
>
  <PageHero kicker={featuresIntro.eyebrow} lines={featuresIntro.lines} accent={featuresIntro.accent} lead={featuresIntro.lead}>
    <nav class="jump" aria-label="On this page" data-rv-stagger="0.04">
      {jump.map((j, i) => (
        <a href={`#${j.id}`}><span class="mono">{String(i + 1).padStart(2, "0")}</span>{j.label}</a>
      ))}
    </nav>
  </PageHero>

  {
    deepDives.map((dive, i) => {
      const h = parse(dive.heading);
      return (
        <section
          class:list={["dive", { alt: i % 2 === 1, wide: "wide" in dive && dive.wide }]}
          id={dive.id}
          aria-labelledby={`${dive.id}-h`}
        >
          <div class="dive-grid">
            <div class="copy">
              <div class="dive-n display" aria-hidden="true">{String(i + 1).padStart(2, "0")}</div>
              <div class="kicker" data-rv>{dive.tag}</div>
              <h2 id={`${dive.id}-h`} class="h2 rv-h"><Split text={h.text} accent={h.accent} by="words" /></h2>
              <p class="lead body-l" data-rv>{dive.lead}</p>
              <ul class="points" data-rv-stagger>
                {dive.points.map((p) => (
                  <li>
                    <span class="p-title">{p.title}</span>
                    <span class="p-body">{p.body}</span>
                  </li>
                ))}
              </ul>
              {"more" in dive && dive.more && (
                <a class="text-link dive-more" href={dive.more.href}>{dive.more.label}</a>
              )}
            </div>

            <div class="visual" data-rv="plate">
              {dive.mock === "voices" && <VoicePicker />}
              {dive.mock === "bible" && <BibleSideBySide />}
              {dive.mock === "practices" && (
                <PracticeMock
                  searchPlaceholder={practices.searchPlaceholder}
                  openLine={practices.openLine}
                  cards={practices.cards}
                  active={practices.active}
                  note={practices.note}
                />
              )}
              {dive.mock === "letter" && <LookingBackMock horizons={lookingBack.horizons} lenses={lookingBack.lenses} />}
              {dive.mock === "altar" && (
                <AltarMock subtitle={altar.mock.subtitle} intro={altar.mock.intro} groups={altar.mock.groups} note={altar.mock.note} />
              )}
              {dive.mock === "scripture" && <ScriptureTeaser />}
              {dive.mock === "lock" && <LockMock />}
              {dive.mock === "pages" && (
                <ProductShot name="pages-search" size={{ w: 1280, h: 1020 }} panel={{ w: 1280, h: 540 }} alt={pages.shotAlt} />
              )}
            </div>
          </div>
        </section>
      );
    })
  }

  {/* the exhaustive list — show how much is actually here */}
  <section class="everything" id="everything" aria-labelledby="ev-h">
    <div class="ev-head">
      <div class="kicker" data-rv>{everythingIntro.tag}</div>
      <h2 id="ev-h" class="h2 rv-h"><Split {...parse(everythingIntro.heading)} by="words" /></h2>
      <p class="body-l" data-rv>{everythingIntro.lead}</p>
      <p class="ev-value" data-rv set:html={everythingIntro.valueLine} />
    </div>
    <div class="ev-grid" data-rv-stagger="0.08">
      {
        everything.map((col) => (
          <section class="ev-col">
            <h3 class="ev-group">{col.group}</h3>
            <ul class="ev-list">
              {col.items.map((it) => (
                <li>
                  <span class="ev-check" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="11" height="11">
                      <path d="M2.5 8.5l3.5 3.5 7-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="ev-item" set:html={it} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<script>
  import { boot, reveal, gsap, reduced } from "../lib/motion";
  boot();
  reveal();
  // the big chapter numbers drift against the scroll, a little behind the copy
  if (!reduced) {
    gsap.utils.toArray<HTMLElement>(".dive-n").forEach((n) => {
      gsap.fromTo(n, { yPercent: 40 }, { yPercent: -40, ease: "none", scrollTrigger: { trigger: n.closest(".dive"), start: "top bottom", end: "bottom top", scrub: 0.6 } });
    });
  }
</script>

<style>
  /* ---- jump list ---- */
  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 1100px;
    margin: 48px auto 0;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    backdrop-filter: blur(8px);
    font-size: 14px;
    color: var(--paper-dim);
    text-decoration: none;
    cursor: default;
    transition: border-color 0.25s, color 0.25s;
  }
  .jump a .mono {
    font-size: 10.5px;
    color: var(--dawn-1);
  }
  @media (hover: hover) {
    .jump a:hover {
      border-color: var(--border-strong);
      color: var(--paper);
    }
  }
  .jump a:active {
    transform: scale(0.97);
  }

  /* ---- chapters ---- */
  .dive {
    position: relative;
    padding: clamp(90px, 16vh, 170px) 24px;
    scroll-margin-top: 40px;
  }
  .dive:first-of-type {
    padding-top: clamp(110px, 18vh, 200px);
  }
  .dive-grid {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .dive.alt .copy {
    order: 2;
  }
  .copy {
    position: relative;
  }
  .dive-n {
    position: absolute;
    top: -0.55em;
    left: -0.06em;
    font-size: clamp(120px, 16vw, 230px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--border-strong);
    opacity: 0.7;
    z-index: -1;
    pointer-events: none;
    user-select: none;
  }
  .copy .kicker {
    margin-bottom: 18px;
  }
  .copy .h2 {
    font-size: clamp(34px, 4.4vw, 60px);
    margin-bottom: 22px;
    max-width: 15ch;
  }
  .copy .h2 :global(.w) {
    display: inline-block;
  }
  .copy .lead {
    max-width: 46ch;
    margin-bottom: 30px;
  }
  .points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .points li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 18px;
    border-left: 1px solid var(--border-strong);
  }
  .p-title {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--paper);
  }
  .p-body {
    font-size: 15.5px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.6;
  }
  .dive-more {
    display: inline-block;
    margin-top: 28px;
  }

  /* a wide chapter stacks: copy two-up above a full-measure plate */
  .dive.wide .dive-grid {
    grid-template-columns: 1fr;
    gap: 56px;
  }
  .dive.wide .copy {
    order: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .dive.wide .copy > .kicker,
  .dive.wide .copy > .h2,
  .dive.wide .copy > .lead {
    grid-column: 1;
  }
  .dive.wide .copy > .h2 {
    max-width: 18ch;
  }
  .dive.wide .copy > .points {
    grid-column: 2;
    grid-row: 1 / span 4;
    align-self: end;
  }
  .dive.wide .copy > .dive-more {
    grid-column: 1;
  }

  /* ---- everything ---- */
  .everything {
    padding: clamp(90px, 16vh, 170px) 24px 120px;
  }
  .ev-head {
    max-width: 760px;
    margin: 0 auto 64px;
    text-align: center;
  }
  .ev-head .kicker {
    margin-bottom: 16px;
  }
  .ev-head .h2 {
    margin-bottom: 20px;
  }
  .ev-head .h2 :global(.w) {
    display: inline-block;
  }
  .ev-value {
    display: inline-block;
    margin-top: 26px;
    padding: 9px 18px;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--paper-dim);
  }
  .ev-value :global(strong) {
    color: var(--dawn-1);
    font-weight: 500;
  }
  .ev-grid {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 44px 36px;
  }
  .ev-group {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    font-weight: 400;
  }
  .ev-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .ev-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .ev-check {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    margin-top: 1px;
    border-radius: 50%;
    color: var(--dawn-1);
    background: var(--accent-glow);
  }
  .ev-item {
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--paper-dim);
    font-weight: 300;
  }

  @media (max-width: 1040px) {
    .ev-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .dive-grid,
    .dive.wide .copy {
      grid-template-columns: 1fr;
    }
    .dive.alt .copy {
      order: 0;
    }
    .dive.wide .copy > .points {
      grid-column: 1;
      grid-row: auto;
    }
    .dive-n {
      font-size: 120px;
    }
  }
  @media (max-width: 520px) {
    .ev-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .jump {
      justify-content: flex-start;
    }
  }
</style>
