---
// ProductShot — a real screenshot of a shipped surface, in a Mac window frame.
//
// The site's other product visuals are CSS recreations (see SCREENSHOTS.md).
// These earn a photograph because density is the argument — a decade of pages,
// a whole shelf of practices — and no honest recreation is smaller than the
// capture. All of them come from `npm run screenshots:site`, never by hand.
//
// Both palettes are captured, because the site has a theme toggle and a
// parchment screenshot on an ink page reads as a bug.
//
// A phone can't read a 1280px surface scaled into a 335px column. With a
// `panel` crop, the phone gets that crop instead; without one, it gets the
// full capture at native width. Either way it sits in a swipeable box at 1 CSS
// px per captured px — fewer pixels of the app, all of them legible.
interface Props {
  /** File stem in /screenshots, e.g. "pages-search" → pages-search-{light,dark}.png */
  name: string;
  /** Intrinsic CSS size of the capture, so the box reserves its space. */
  size: { w: number; h: number };
  /** Optional phone crop, written as <name>-{light,dark}-panel.png. */
  panel?: { w: number; h: number };
  alt: string;
  /** Mono hint under the phone crop, telling a thumb the box moves. */
  swipeHint?: string;
  class?: string;
}
const {
  name,
  size,
  panel,
  alt,
  swipeHint = "swipe to read across →",
  class: className = "",
} = Astro.props;

const src = (theme: "light" | "dark", suffix = "") => ({
  src: `/screenshots/${name}-${theme}${suffix}.png`,
  srcset: `/screenshots/${name}-${theme}${suffix}.png 1x, /screenshots/${name}-${theme}${suffix}@2x.png 2x`,
});
---

<figure class:list={["shot", className]}>
  <div class="chrome" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class:list={["rail", { "has-panel": !!panel }]}>
    <img class="shot-img is-full is-dark" {...src("dark")} width={size.w} height={size.h} alt={alt} loading="lazy" decoding="async" />
    <img class="shot-img is-full is-light" {...src("light")} width={size.w} height={size.h} alt="" aria-hidden="true" loading="lazy" decoding="async" />
    {
      panel && (
        <>
          <img class="shot-img is-panel is-dark" {...src("dark", "-panel")} width={panel.w} height={panel.h} alt={alt} loading="lazy" decoding="async" />
          <img class="shot-img is-panel is-light" {...src("light", "-panel")} width={panel.w} height={panel.h} alt="" aria-hidden="true" loading="lazy" decoding="async" />
        </>
      )
    }
  </div>
</figure>
<p class="swipe-hint mono" aria-hidden="true">{swipeHint}</p>

<style>
  .shot {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    overflow: hidden;
    background: var(--ink-2);
    box-shadow:
      0 60px 120px -50px var(--shadow),
      0 0 90px -45px var(--accent-glow);
    margin: 0;
  }

  /* A slim title bar, because the point of this section is now "install it".
     The app itself hides its titlebar and floats the lights over the content —
     which is exactly where the `look for` pill sits, so here they get a strip
     of their own rather than sitting on top of the control being advertised. */
  .chrome {
    display: flex;
    gap: 7px;
    align-items: center;
    height: 34px;
    padding: 0 15px;
    background: var(--ink-3);
    border-bottom: 1px solid var(--border);
  }
  .chrome i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    opacity: 0.65;
  }
  .chrome i:nth-child(1) {
    background: #e8917c;
  }
  .chrome i:nth-child(2) {
    background: #f3bd76;
  }
  .chrome i:nth-child(3) {
    background: #9fcf8f;
  }

  .shot-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Two axes of choice: palette (the theme toggle sets data-theme on <html>,
     dark being the default) and crop (width). Everything is hidden by default
     and one combination is switched back on, which is shorter than writing the
     four negations. */
  .shot-img {
    display: none;
  }
  .shot-img.is-full.is-dark {
    display: block;
  }
  :global([data-theme="light"]) .shot-img.is-full.is-dark {
    display: none;
  }
  :global([data-theme="light"]) .shot-img.is-full.is-light {
    display: block;
  }

  .swipe-hint {
    display: none;
  }

  /* Phone: 1 CSS px per captured px, in a scroller — the panel crop if there
     is one, the whole capture otherwise. The width/height attributes carry the
     intrinsic size, so `width: auto` lands on exactly that. Anything that fits
     the whole surface into the column is too small to read. */
  @media (max-width: 760px) {
    .rail {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .rail::-webkit-scrollbar {
      display: none;
    }
    .shot-img {
      width: auto;
      max-width: none;
    }
    .has-panel .shot-img.is-full.is-dark,
    :global([data-theme="light"]) .has-panel .shot-img.is-full.is-light {
      display: none;
    }
    .has-panel .shot-img.is-panel.is-dark {
      display: block;
    }
    :global([data-theme="light"]) .has-panel .shot-img.is-panel.is-dark {
      display: none;
    }
    :global([data-theme="light"]) .has-panel .shot-img.is-panel.is-light {
      display: block;
    }

    .swipe-hint {
      display: block;
      margin-top: 10px;
      font-size: 10.5px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: var(--muted);
    }
  }
</style>
