---
// SlashShowcase — the Act-I signature moment. An editor that types its way
// through the slash commands and resolves each one inline, beside a reference
// of all five. Show, don't tell: the spiritual life captured in the sentence.
// Data is authoritative to the app (slashCommands in content/home.ts).
interface Command {
  id: string;
  label: string;
  hint: string;
  blurb: string;
}
interface DemoResult {
  kind: string;
  ref?: string;
  text: string;
}
interface DemoStep {
  label: string;
  typed: string;
  result: DemoResult;
}
interface Props {
  commands: Command[];
  demo: DemoStep[];
  contextLines?: string[];
  class?: string;
}
const {
  commands,
  demo,
  contextLines = [
    "Hard conversation with Marcus today.",
    "I went in defensive and left grateful — not sure when that shifted.",
  ],
  class: className = "",
} = Astro.props;

// the order the demo cycles through, by command id (e.g. /scripture → scripture)
const seq = demo.map((d) => d.label.replace(/^\//, ""));
---

<div class:list={["slash-showcase", className]} data-seq={seq.join(",")}>
  {/* left — the live editor demo */}
  <div class="ss-editor" aria-hidden="true">
    <div class="ss-chrome"><i></i><i></i><i></i></div>
    <div class="ss-page">
      {contextLines.map((l) => <p class="ss-ctx">{l}</p>)}

      <div class="ss-cmdline">
        <span class="ss-slash">/</span>
        {
          demo.map((d, i) => (
            <span class="ss-cmd" data-i={i}>
              {seq[i]} <span class="ss-query">{d.typed}</span>
            </span>
          ))
        }
        <span class="ss-caret"></span>
      </div>

      {/* the palette — the active command lifts */}
      <nav class="ss-palette" aria-label="Slash commands">
        {
          commands.map((c) => (
            <div class="ss-pal-item" data-cmd={c.id}>
              <span class="ss-pal-label">{c.label}</span>
              <span class="ss-pal-hint">{c.hint}</span>
            </div>
          ))
        }
      </nav>

      {/* resolved inline blocks — one per step, only the active shows */}
      <div class="ss-results">
        {
          demo.map((d, i) => (
            <div class:list={["ss-result", `k-${d.result.kind}`]} data-i={i}>
              {d.result.kind === "scripture" && (
                <blockquote class="r-scripture">
                  <p class="rs-text">{d.result.text}</p>
                  <p class="rs-ref mono">{d.result.ref} · ESV</p>
                </blockquote>
              )}
              {d.result.kind === "pray" && (
                <p class="r-pray">
                  <span class="r-dot prayer" /> {d.result.text}
                  <span class="r-tag mono">prayer · kept</span>
                </p>
              )}
              {d.result.kind === "sense" && (
                <p class="r-sense">
                  <span class="r-dot sense" /> <em>{d.result.text}</em>
                  <span class="r-tag mono">a sense</span>
                </p>
              )}
              {d.result.kind === "ritual" && (
                <div class="r-ritual">
                  <span class="r-ritual-name mono">{d.result.text}</span>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {/* right — the five commands, the active one lifts in sync */}
  <ul class="ss-list">
    {
      commands.map((c) => (
        <li class="ss-card" data-cmd={c.id}>
          <span class="ss-card-label mono">{c.label}</span>
          <span class="ss-card-hint">{c.hint}</span>
          <span class="ss-card-blurb">{c.blurb}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .slash-showcase {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 36px;
    align-items: start;
  }

  /* ---- editor ---- */
  .ss-editor {
    position: relative;
    background: var(--ink-2);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 50px 100px -50px var(--shadow);
    min-height: 420px;
  }
  .ss-chrome {
    display: flex;
    gap: 7px;
    padding: 15px 16px 0;
  }
  .ss-chrome i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    opacity: 0.65;
  }
  .ss-chrome i:nth-child(1) { background: var(--dawn-2); }
  .ss-chrome i:nth-child(2) { background: var(--dawn-1); }
  .ss-chrome i:nth-child(3) { background: #9fcf8f; }

  .ss-page {
    padding: 26px 34px 36px;
  }
  .ss-ctx {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    font-weight: 300;
    color: var(--paper);
    margin: 0 0 12px;
    max-width: 52ch;
  }

  .ss-cmdline {
    position: relative;
    margin-top: 4px;
    min-height: 1.7em;
    font-family: var(--font-mono);
    font-size: 15px;
  }
  .ss-slash {
    color: var(--dawn-1);
  }
  .ss-cmd {
    display: none;
    color: var(--dawn-1);
  }
  .ss-cmd.is-active {
    display: inline;
  }
  .ss-query {
    color: var(--paper-dim);
  }
  .ss-caret {
    display: inline-block;
    width: 7px;
    height: 17px;
    vertical-align: -3px;
    background: var(--dawn-1);
    margin-left: 2px;
    animation: ss-blink 1.1s steps(1) infinite;
  }
  @keyframes ss-blink {
    50% { opacity: 0; }
  }

  /* palette */
  .ss-palette {
    margin-top: 12px;
    width: min(100%, 320px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    border-radius: 12px;
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    box-shadow: 0 10px 28px -16px var(--shadow);
  }
  .ss-pal-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 9px 11px;
    border-radius: 8px;
    border: 1px solid transparent;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .ss-pal-item.is-active {
    background: var(--accent-glow);
    border-color: var(--accent-glow);
  }
  .ss-pal-label {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--paper-dim);
  }
  .ss-pal-item.is-active .ss-pal-label {
    color: var(--dawn-1);
  }
  .ss-pal-hint {
    font-size: 11.5px;
    color: var(--muted);
    font-weight: 300;
  }

  /* results — only the active one shows */
  .ss-results {
    position: relative;
    margin-top: 16px;
    min-height: 86px;
  }
  .ss-result {
    display: none;
    animation: ss-rise 0.5s cubic-bezier(0.16, 0.7, 0.2, 1);
  }
  .ss-result.is-active {
    display: block;
  }
  @keyframes ss-rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  .r-scripture {
    margin: 0;
    padding-left: 18px;
    border-left: 2px solid var(--dawn-1);
    max-width: 54ch;
  }
  .rs-text {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 16px;
    line-height: 1.6;
    color: var(--paper-dim);
    margin: 0 0 6px;
    font-weight: 300;
  }
  .rs-ref {
    font-size: 10.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .r-pray,
  .r-sense {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--paper);
    font-weight: 300;
    margin: 0;
    line-height: 1.5;
  }
  .r-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .r-dot.prayer {
    background: var(--dawn-1);
    box-shadow: 0 0 9px var(--accent-glow);
  }
  .r-dot.sense {
    background: var(--dawn-2);
    box-shadow: 0 0 9px var(--accent-glow);
  }
  .r-tag {
    font-size: 9.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 2px 9px;
  }

  .r-ritual {
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    padding: 14px 16px;
    background: var(--surface);
  }
  .r-ritual-name {
    font-size: 13px;
    color: var(--dawn-1);
    line-height: 1.5;
    letter-spacing: 0.2px;
  }

  /* ---- right list ---- */
  .ss-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ss-card {
    display: grid;
    gap: 5px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    transition: border-color 0.35s ease, background 0.35s ease, transform 0.35s ease;
  }
  .ss-card.is-active {
    border-color: var(--accent-glow);
    background: var(--surface-2);
    transform: translateX(4px);
  }
  .ss-card-label {
    font-size: 13px;
    color: var(--dawn-1);
    letter-spacing: 0.2px;
  }
  .ss-card-hint {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--paper);
  }
  .ss-card-blurb {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--paper-dim);
    font-weight: 300;
  }

  @media (max-width: 900px) {
    .slash-showcase {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-result { animation: none; }
    .ss-caret { animation: none; }
  }
</style>

<script>
  // Cycle the demo: lift the active command in the palette, show its typed
  // query and its resolved inline block, and sync the reference card.
  for (const root of document.querySelectorAll<HTMLElement>(".slash-showcase")) {
    const seq = (root.dataset.seq || "").split(",").filter(Boolean);
    if (!seq.length) continue;

    const cmds = root.querySelectorAll<HTMLElement>(".ss-cmd");
    const results = root.querySelectorAll<HTMLElement>(".ss-result");
    const palItems = root.querySelectorAll<HTMLElement>(".ss-pal-item");
    const cards = root.querySelectorAll<HTMLElement>(".ss-card");

    let i = 0;
    const apply = (n: number) => {
      const id = seq[n];
      cmds.forEach((el, k) => el.classList.toggle("is-active", k === n));
      results.forEach((el, k) => el.classList.toggle("is-active", k === n));
      palItems.forEach((el) =>
        el.classList.toggle("is-active", el.dataset.cmd === id),
      );
      cards.forEach((el) =>
        el.classList.toggle("is-active", el.dataset.cmd === id),
      );
    };
    apply(0);

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) continue;

    let timer: number | undefined;
    const start = () => {
      timer = window.setInterval(() => {
        i = (i + 1) % seq.length;
        apply(i);
      }, 3400);
    };
    // Only animate while in view.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && timer === undefined) start();
        else if (!e.isIntersecting && timer !== undefined) {
          clearInterval(timer);
          timer = undefined;
        }
      }
    });
    io.observe(root);
  }
</script>
