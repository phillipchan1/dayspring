---
// TestimonialBand — one real interview quote, quiet and centered.
// A proof point, not a hero claim — see content/home.ts `testimonial`.
interface Props {
  quote: string;
  attribution: string;
  context?: string;
  class?: string;
}
const { quote, attribution, context, class: className = "" } = Astro.props;
---

<div class:list={["testimonial-band", className]}>
  <p class="mark" aria-hidden="true">&ldquo;</p>
  <blockquote class="quote">{quote}</blockquote>
  <p class="who">
    <span class="attribution">{attribution}</span>
    {context && <span class="context"> · {context}</span>}
  </p>
</div>

<style>
  .testimonial-band {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
  }
  .mark {
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1;
    color: var(--dawn-1);
    opacity: 0.5;
    margin: 0 0 -8px;
  }
  .quote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(22px, 3.2vw, 32px);
    line-height: 1.42;
    letter-spacing: -0.3px;
    color: var(--paper);
    margin: 0 0 20px;
  }
  .who {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.3px;
    color: var(--muted);
    margin: 0;
  }
  .attribution {
    color: var(--dawn-1);
  }
</style>
