---
// Nav — sticky, transparent over the hero; gains a blurred ink background
// once scrolled. Text links collapse on mobile; the download pills stay.
import Mark from "./Mark.astro";
import { navLinks, downloads, site, releasesRepo } from "../content/site";

// Apple logo glyph — shared by both download pills.
const applePath =
  "M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26 2 49.9-11.4 69.5-34.3z";
---

<nav id="nav" aria-label="Primary">
  <a href="/" class="brand"><Mark size={22} />{site.name}</a>
  <div class="navlinks">
    {
      navLinks.map((link) => (
        <a href={link.href} class="txt">
          {link.label}
        </a>
      ))
    }
    <button
      type="button"
      id="theme-toggle"
      class="theme-toggle"
      aria-label="Toggle light and dark theme"
      title="Toggle theme"
    >
      <svg class="ico-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="ico-moon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
    <a
      href={downloads.macos.href}
      class="dl dl-macos"
      data-dl-macos
      data-repo={releasesRepo}
      aria-label="Download for macOS"
    >
      <svg viewBox="0 0 384 512" aria-hidden="true"><path d={applePath} /></svg>
      {downloads.macos.label}
    </a>
    <span
      class="dl dl-soon"
      role="note"
      aria-label="iOS — coming soon"
      title="Coming soon"
    >
      <svg viewBox="0 0 384 512" aria-hidden="true"><path d={applePath} /></svg>
      {downloads.ios.label}<span class="soon">{downloads.ios.soonLabel}</span>
    </span>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 28px;
    max-width: var(--maxw);
    margin: 0 auto;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, padding 0.4s ease;
  }
  nav.scrolled {
    background: var(--nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 14px 28px;
    border-bottom: 1px solid var(--border);
  }

  /* theme toggle — quiet, icon-only; the right glyph shows per theme */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: transparent;
    color: var(--paper-dim);
    cursor: pointer;
    transition: color 0.25s, border-color 0.25s, background 0.25s;
    padding: 0;
  }
  .theme-toggle:hover {
    color: var(--paper);
    border-color: var(--border-strong);
  }
  .theme-toggle svg {
    width: 17px;
    height: 17px;
  }
  /* show sun in dark mode (offer light), moon in light mode (offer dark) */
  .theme-toggle .ico-moon {
    display: none;
  }
  :global([data-theme="light"]) .theme-toggle .ico-sun {
    display: none;
  }
  :global([data-theme="light"]) .theme-toggle .ico-moon {
    display: inline;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 21px;
    letter-spacing: 0.3px;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--paper);
    text-decoration: none;
  }
  .navlinks {
    display: flex;
    gap: 30px;
    align-items: center;
  }
  .navlinks a {
    color: var(--paper-dim);
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.4px;
    transition: color 0.25s;
  }
  .navlinks a:hover {
    color: var(--paper);
  }

  .navlinks .dl {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.4px;
    color: var(--paper);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 8px 15px 8px 13px;
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }
  .navlinks .dl svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
    transform: translateY(-1px);
  }
  .navlinks .dl:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }

  /* iOS — coming soon: present but not clickable */
  .navlinks .dl-soon {
    color: var(--muted);
    cursor: default;
  }
  .navlinks .dl-soon:hover {
    background: none;
    color: var(--muted);
    border-color: var(--border);
  }
  .navlinks .dl-soon .soon {
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--dawn-1);
    border: 1px solid var(--accent-glow);
    border-radius: 100px;
    padding: 1px 6px;
    margin-left: 2px;
  }

  /* mobile: collapse the text nav; hide the Mac .dmg so phone traffic
     (FB/IG) is not sent at a desktop download. iOS Soon stays. */
  @media (max-width: 680px) {
    .navlinks a.txt {
      display: none;
    }
    .navlinks a.dl-macos {
      display: none;
    }
    .navlinks {
      gap: 12px;
    }
  }

  /* very small: tighten so the toggle + both pills fit without clipping */
  @media (max-width: 440px) {
    nav,
    nav.scrolled {
      padding-left: 16px;
      padding-right: 16px;
    }
    .brand {
      font-size: 18px;
      gap: 7px;
    }
    .navlinks {
      gap: 8px;
    }
    .theme-toggle {
      width: 30px;
      height: 30px;
    }
    .navlinks .dl {
      padding: 7px 11px 7px 10px;
      font-size: 11.5px;
      gap: 5px;
    }
  }
</style>

<script>
  // Theme toggle — flip the explicit choice, persist it, update theme-color.
  const themeBtn = document.getElementById("theme-toggle");
  if (themeBtn) {
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    const colorFor = (t: string) => (t === "light" ? "#f1ebdf" : "#0c0d11");
    themeBtn.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch {}
      if (meta) meta.content = colorFor(next);
    });
  }

  // Blur the nav background once the page is scrolled past the hero edge.
  const nav = document.getElementById("nav");
  if (nav) {
    const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 40);
    onScroll();
    addEventListener("scroll", onScroll, { passive: true });
  }

  // macOS download — always resolve the LATEST .dmg from GitHub Releases.
  // Progressive enhancement: the link's href falls back to the latest-release
  // page (works with no JS / if the API is unreachable). On hover/focus we
  // pre-resolve the exact .dmg via the GitHub REST API (CORS-enabled) and
  // rewrite the href so the click is a direct, instant download.
  const macBtn = document.querySelector<HTMLAnchorElement>("[data-dl-macos]");
  if (macBtn) {
    const repo = macBtn.dataset.repo;
    let resolved: string | null = null;
    let pending: Promise<string | null> | null = null;

    const resolve = () => {
      if (resolved) return Promise.resolve(resolved);
      if (pending) return pending;
      pending = fetch(`https://api.github.com/repos/${repo}/releases/latest`, {
        headers: { Accept: "application/vnd.github+json" },
      })
        .then((r) => (r.ok ? r.json() : null))
        .then((rel) => {
          const assets = (rel && rel.assets) || [];
          const dmg =
            assets.find((a: any) => /aarch64.*\.dmg$/i.test(a.name)) ||
            assets.find((a: any) => /\.dmg$/i.test(a.name));
          if (dmg) {
            resolved = dmg.browser_download_url;
            macBtn.href = resolved;
          }
          return resolved;
        })
        .catch(() => null);
      return pending;
    };

    // Pre-resolve before the click so the download is instant.
    macBtn.addEventListener("pointerenter", resolve, { once: true });
    macBtn.addEventListener("focus", resolve, { once: true });

    // If the click lands before we've resolved, fetch then navigate.
    // The default href (latest-release page) is the safety net.
    macBtn.addEventListener("click", (e) => {
      if (resolved) return; // href already points straight at the .dmg
      e.preventDefault();
      resolve().then((url) => {
        window.location.href = url || macBtn.href;
      });
    });
  }
</script>
