---
// AltarMock — "a place of remembrance," recreated from the shipped app.
// Prayers & senses gather by subject (people you carry / places & callings /
// what He keeps tending in you). Each is an ember kept before Him; a lit one
// is where He met you. Not a queue of requests — a testimony over years.
interface Item {
  subject: string;
  span: string;
  lit?: boolean;
  movement?: string;
}
interface Group {
  title: string;
  note?: string;
  items: Item[];
}
interface Props {
  subtitle?: string;
  intro?: string;
  groups: Group[];
  note?: string;
  class?: string;
}
const {
  subtitle = "A place of remembrance",
  intro,
  groups,
  note,
  class: className = "",
} = Astro.props;
---

<div class:list={["altar-mock", className]}>
  <header class="altar-head">
    <h3 class="altar-title">Altar</h3>
    <p class="altar-sub">{subtitle}</p>
    <div class="altar-tabs" aria-hidden="true">
      <span class="tab active">Subjects</span>
      <span class="tab">Over time</span>
    </div>
  </header>

  {intro && <p class="altar-intro">{intro}</p>}

  <div class="altar-groups">
    {
      groups.map((g) => (
        <section class="altar-group">
          <h4 class="group-title">
            {g.title}
            {g.note && <span class="group-note mono">{g.note}</span>}
          </h4>
          <ul class="subjects">
            {g.items.map((it) => (
              <li class:list={["subject", { lit: it.lit }]}>
                <div class="subject-top">
                  <span class="subject-name">{it.subject}</span>
                  <span class="subject-span mono">{it.span}</span>
                </div>
                <div class="ember" aria-hidden="true" />
                {it.movement && <span class="subject-move mono">{it.movement}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  {note && <p class="altar-note">{note}</p>}
</div>

<style>
  .altar-mock {
    container-type: inline-size;
    border-radius: 18px;
    background: var(--card-grad);
    border: 1px solid var(--border);
    padding: 26px 26px 28px;
    max-width: 100%;
    overflow: hidden;
    box-shadow: 0 40px 80px -50px var(--shadow);
  }

  .altar-head {
    margin-bottom: 18px;
  }
  .altar-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2rem);
    color: var(--paper);
    letter-spacing: 0.01em;
    margin: 0;
  }
  .altar-sub {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 15px;
    color: var(--paper-dim);
  }
  .altar-tabs {
    display: flex;
    gap: 22px;
    margin-top: 16px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0;
  }
  .altar-tabs .tab {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--muted);
    padding-bottom: 8px;
    margin-bottom: -1px;
  }
  .altar-tabs .tab.active {
    color: var(--dawn-1);
    border-bottom: 1.5px solid var(--dawn-1);
  }

  .altar-intro {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 15px;
    color: var(--dawn-1);
    margin: 16px 0 4px;
    line-height: 1.5;
  }

  .altar-groups {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-top: 14px;
  }
  .group-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 16px;
    color: var(--paper);
    margin: 0 0 12px;
  }
  .group-note {
    font-size: 9.5px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
  }

  .subjects {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .subject {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 13px 15px 15px;
    background: var(--surface);
  }
  .subject-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .subject-name {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--paper);
    letter-spacing: 0.01em;
  }
  .subject-span {
    font-size: 9.5px;
    letter-spacing: 0.4px;
    color: var(--muted);
    text-align: right;
    flex: none;
  }
  /* the ember — a prayer kept before Him; lit = where He met you */
  .ember {
    height: 14px;
    border-radius: 8px;
    margin-top: 11px;
    background: linear-gradient(
      90deg,
      var(--dawn-3),
      var(--dawn-1) 50%,
      var(--dawn-2)
    );
    opacity: 0.32;
    filter: blur(0.5px);
  }
  .subject.lit .ember {
    opacity: 0.85;
    box-shadow:
      0 0 14px var(--accent-glow),
      0 0 30px var(--accent-glow);
  }
  .subject-move {
    display: block;
    margin-top: 9px;
    font-size: 9.5px;
    letter-spacing: 0.5px;
    text-transform: lowercase;
    color: var(--dawn-1);
  }

  .altar-note {
    margin: 20px 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
    line-height: 1.5;
  }

  @container (max-width: 460px) {
    .subject-span {
      display: none;
    }
  }
</style>
