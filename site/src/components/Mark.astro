---
// The Dayspring sunrise mark — sun cresting the horizon with rays.
// Matches src/components/Mark.tsx in phillipchan1/dayspring.
interface Props {
  /** Square edge length in px. */
  size?: number;
  class?: string;
}
const { size = 22, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class:list={["mark", className]}
>
  <path d="M5 17a7 7 0 0 1 14 0" fill="currentColor" />
  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <path d="M12 3v3" />
    <path d="M4.4 7.4l2.1 2.1" />
    <path d="M19.6 7.4l-2.1 2.1" />
    <path d="M2.5 17h19" />
  </g>
</svg>

<style>
  .mark {
    color: #e0a64e;
    flex-shrink: 0;
  }
</style>
