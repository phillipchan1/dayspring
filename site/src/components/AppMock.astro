---
// AppMock — a native HTML/CSS recreation of the Dayspring desktop app as it
// ships today: the slim icon rail, the frame bar (date · word count · Focus),
// the centred writing column in Fraunces and Newsreader, a verse set in the
// page under its tracked cite, and the two-column `/` palette (Format ·
// Capture). Values were read off the real app's computed styles in both
// shipped palettes — ink for the site's dark theme, dawn for its light one.
// Not a screenshot: real markup, so it stays crisp, themed and animatable.
//
// The palette rows and capture icons come from content/appPalette.ts, which
// appPalette.test.ts holds to the app's own catalog — if the app's palette
// changes, the site build fails until this catches up.
//
// `play` runs the gesture once (see the script below). The markup itself is
// the LAST frame of that sequence, so with no JS or with reduced motion the
// mock is the finished picture, still.
//
// Everything is sized in --u, a thousandth of the mock's width, so it reads as
// the same app scaled rather than reflowed. Narrow containers drop the rail and
// re-base --u so the writing stays legible on a phone.
import Mark from "./Mark.astro";
import { paletteCapture, paletteFormat } from "../content/appPalette";

interface Passage {
  ref: string;
  text: string;
}
interface Props {
  /** Frame bar, left — e.g. "October 6". */
  date?: string;
  /** The entry title (first line, set in the display face). */
  title?: string;
  /** The sentence written before reaching for `/`. */
  line?: string;
  /** What `/scripture` finds "from what you wrote". The first is set. */
  passages?: Passage[];
  /** Translation shown on each result — the app sets ESV. */
  translation?: string;
  /** Capture row the palette rests on at the end (an appPalette id). */
  rest?: string;
  /** Play the gesture once when the mock comes into view. */
  play?: boolean;
  class?: string;
}

const {
  date = "October 6",
  title = "Tuesday",
  line = "Dad's scan is Thursday. I keep rehearsing the worst version.",
  passages = [
    {
      ref: "Psalm 112:7",
      text: "He is not afraid of bad news; his heart is firm, trusting in the LORD.",
    },
  ],
  translation = "ESV",
  rest = "pray",
  play = false,
  class: className = "",
} = Astro.props;

const set = passages[0]!;
const words = (s: string) => s.trim().split(/\s+/).filter(Boolean).length;
// The app counts the writer's prose — title and lines — not a set verse.
const titleWords = words(title);
const finalCount = titleWords + words(line);
const verseWords = set.text.split(" ");
---

<div
  class:list={["appw-frame", className]}
  data-appw
  data-play={play ? "" : undefined}
  data-rest={rest}
  data-title-words={titleWords}
>
  <div class="appw-bloom" aria-hidden="true"></div>

  <div class="appw" aria-hidden="true">
    <div class="titlebar"><span class="lights"><i></i><i></i><i></i></span></div>

    <div class="appw-main">
      {/* rail — Mark, New, then the Return group: Journal, Ascent, Lamp, Altar */}
      <nav class="rail">
        <span class="rail-glow"></span>
        <span class="rb rb-brand"><Mark size={20} class="rail-mark" /></span>
        <span class="rb">
          <svg class="ri" viewBox="0 0 24 24"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
        </span>
        <span class="rail-rule"></span>
        <span class="rb">
          <svg class="ri" viewBox="0 0 24 24"><path d="M12 7v13" /><path d="M3 18a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4a4 4 0 0 1 5 3 4 4 0 0 1 5-3h4a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-5a3 3 0 0 0-4 1 3 3 0 0 0-4-1z" /></svg>
        </span>
        <span class="rb">
          <svg class="ri" viewBox="0 0 24 24"><path d="M3 19h18" /><path d="M6 19l4-8.5 3 4.5 2.5-3.5L19 19" /></svg>
        </span>
        <span class="rb">
          <svg class="ri" viewBox="0 0 24 24"><path d="M4 12.5a5.5 5.5 0 0 0 11 0z" /><path d="M15 12.5h4" /><path d="M9.5 18h3M9.5 18a2 2 0 0 1 1-2" /><path d="M19 12.5c1.4-1 1.4-2.6 0-3.8-1.4 1.2-1.4 2.8 0 3.8z" /></svg>
        </span>
        <span class="rb">
          <svg class="ri" viewBox="0 0 24 24"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" /></svg>
        </span>
        <span class="rail-foot">
          <span class="rb"><span class="you">Y</span></span>
          <span class="rb">
            <svg class="ri" viewBox="0 0 24 24"><path d="M5 7h14" /><path d="M5 12h14" /><path d="M5 17h14" /></svg>
          </span>
        </span>
      </nav>

      <section class="pane">
        <header class="topbar">
          <span class="tb-date">{date}</span>
          <span class="tb-status">
            <i class="tb-dot" data-dot></i>
            <span><span data-count>{finalCount}</span> words</span>
            <span class="tb-sep">·</span>
            <span>saved</span>
            <span class="tb-focus">Focus</span>
          </span>
        </header>

        <div class="page">
          <div class="col">
            <h3 class="ed-title">{title}</h3>
            <p class="ed-line"><span data-typed>{line}</span><span class="caret" data-line-caret hidden></span></p>

            <div class="ed-verse" data-verse="set">
              <div class="ev-clip">
                <div class="ev-block">
                  <span class="ev-rule"></span>
                  <p class="ev-text">
                    {verseWords.map((w, i) => <span class="ev-w" style={`--i:${i}`}>{w} </span>)}
                  </p>
                  <p class="ev-cite"><span class="ev-ref">{set.ref}</span><span class="ev-door">→</span></p>
                </div>
              </div>
            </div>

            <div class="ed-slash" data-slash="on">
              <span class="gutter-plus">+</span>
              <span class="slash-ch" data-slash-ch>/</span><span class="caret" data-slash-caret></span>

              {/* the `/` palette — glass, Format leads, Capture beside it */}
              <div class="palette" data-palette data-open>
                <span class="pal-glow"></span>
                <span class="pal-hi" data-hi></span>
                <div class="pal-col">
                  <div class="pal-head">Format</div>
                  {
                    paletteFormat.map((r) => (
                      <div class="pal-item" data-item={`format:${r.label}`}>
                        <span class:list={["pal-badge", r.badgeStyle && `is-${r.badgeStyle}`]}>{r.badge}</span>
                        <span class="pal-text"><span class="pal-label">{r.label}</span></span>
                      </div>
                    ))
                  }
                </div>
                <div class="pal-col">
                  <div class="pal-head">Capture</div>
                  {
                    paletteCapture.map((r) => (
                      <div class:list={["pal-item", { "is-active": r.id === rest }]} data-item={r.id}>
                        <span class="pal-badge">
                          <svg viewBox="0 0 24 24">
                            {r.icon.map((d) => <path d={d} />)}
                            {r.id === "desire" && <circle cx="19.2" cy="12" r="1.3" />}
                          </svg>
                        </span>
                        <span class="pal-text">
                          <span class="pal-label">{r.label}</span>
                          <span class="pal-hint">{r.hint}</span>
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>

              {/* what Scripture opens: passages found from what was written */}
              <div class="popover" data-popover data-state="ready">
                <div class="pop-chrome">
                  <span class="pop-label">scripture · from what you wrote</span>
                  <span class="pop-search">Search something else…</span>
                </div>
                <div class="pop-loading">
                  <span></span><span class="short"></span>
                  <span></span><span class="short"></span>
                </div>
                <ul class="pop-results">
                  {
                    passages.map((p, i) => (
                      <li class:list={["pop-result", { "is-active": i === 0 }]} data-result style={`--i:${i}`}>
                        <span class="pop-ref">{p.ref} · {translation}</span>
                        <span class="pop-verse">{p.text}</span>
                      </li>
                    ))
                  }
                </ul>
                <div class="pop-foot">↑↓ to choose · enter to set</div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<style>
  .appw-frame {
    container: appw / inline-size;
    position: relative;
  }

  /* ---- palette tokens: the app's ink (dark) and dawn (light) ---- */
  .appw {
    --m-bg: #14161d;
    --m-bg-elevated: #1b1e27;
    --m-bg-input: #20242f;
    --m-bg-hover: #262b38;
    --m-border: #2e3340;
    --m-border-subtle: #23272f;
    --m-text: #c2c6d0;
    --m-text-bright: #eef0f5;
    --m-text-dim: #7a8090;
    --m-text-faint: #565c6a;
    --m-accent: #e0a64e;
    --m-accent-soft: rgba(224, 166, 78, 0.14);
    --m-heading: #e0a64e;
    --m-glow: radial-gradient(120% 130% at 50% -30%, rgba(186, 202, 236, 0.14), rgba(150, 170, 210, 0.04) 45%, transparent 66%);
    --m-glass-bg: rgba(27, 30, 39, 0.72);
    --m-glass-border: rgba(236, 231, 221, 0.1);
    --m-glass-edge: rgba(255, 255, 255, 0.09);
    --m-glass-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.78);
    --m-glass-shadow-glow: 0 0 60px -30px rgba(224, 166, 78, 0.18);
    --m-glass-spot: rgba(224, 166, 78, 0.2);
    --m-rail-bg: rgba(20, 22, 29, 0.55);
    --m-rail-edge: rgba(255, 255, 255, 0.045);
    --m-titlebar: #1d2029;
    --m-window-edge: rgba(255, 255, 255, 0.08);
    --m-pop-shadow: 0 10px 30px -14px rgba(0, 0, 0, 0.6), 0 2px 8px -4px rgba(0, 0, 0, 0.4);
    --m-bloom: rgba(224, 166, 78, 0.2);

    /* one unit = a thousandth of the mock; the palette reads a touch larger
       than true scale so its plain English is legible in a hero */
    --u: calc(100cqi / 1000);
    --pu: calc(var(--u) * 1.15);

    --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --label: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
  }
  :global([data-theme="light"]) .appw {
    --m-bg: #fbf6ee;
    --m-bg-elevated: #fffdf8;
    --m-bg-input: #f3ece0;
    --m-bg-hover: #efe6d6;
    --m-border: #e2d7c4;
    --m-border-subtle: #ece3d4;
    --m-text: #4a4035;
    --m-text-bright: #2a2118;
    --m-text-dim: #8a7c69;
    --m-text-faint: #b4a78f;
    --m-accent: #c2683a;
    --m-accent-soft: rgba(194, 104, 58, 0.12);
    --m-heading: #b5552c;
    --m-glow: radial-gradient(120% 130% at 50% -30%, rgba(224, 150, 70, 0.22), rgba(181, 80, 58, 0.05) 40%, transparent 64%);
    --m-glass-bg: rgba(255, 253, 248, 0.84);
    --m-glass-border: rgba(74, 64, 53, 0.14);
    --m-glass-edge: rgba(255, 255, 255, 0.92);
    --m-glass-shadow: 0 36px 64px -32px rgba(74, 64, 53, 0.28);
    --m-glass-shadow-glow: 0 0 48px -24px rgba(224, 150, 70, 0.22);
    --m-glass-spot: rgba(224, 150, 70, 0.24);
    --m-rail-bg: rgba(251, 246, 238, 0.72);
    --m-rail-edge: rgba(74, 64, 53, 0.08);
    --m-titlebar: #f1e9dc;
    --m-window-edge: rgba(74, 64, 53, 0.16);
    --m-pop-shadow: 0 10px 30px -14px rgba(40, 24, 8, 0.3), 0 2px 8px -4px rgba(40, 24, 8, 0.14);
    --m-bloom: rgba(224, 150, 70, 0.22);
  }

  /* ---- window ---- */
  .appw {
    position: relative;
    z-index: 1;
    background: var(--m-bg);
    border: 1px solid var(--m-window-edge);
    border-radius: max(10px, calc(14 * var(--u)));
    overflow: hidden;
    box-shadow: 0 50px 100px -45px var(--shadow);
    color: var(--m-text);
    font-family: var(--sans);
    transition: background 0.5s ease;
  }
  .titlebar {
    height: calc(32 * var(--u));
    min-height: 20px;
    display: flex;
    align-items: center;
    padding-left: max(10px, calc(14 * var(--u)));
    background: var(--m-titlebar);
  }
  .lights {
    display: flex;
    gap: max(5px, calc(8 * var(--u)));
  }
  .lights i {
    width: max(8px, calc(12 * var(--u)));
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .lights i:nth-child(1) { background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }

  /* tall enough that the palette, open under the last line, ends inside the
     window — clipped mid-row as the app clips it, never cut by the frame */
  .appw-main {
    display: flex;
    min-height: calc(700 * var(--u));
  }

  /* ---- rail ---- */
  .rail {
    position: relative;
    flex: none;
    width: calc(72 * var(--u));
    padding: calc(8 * var(--u)) 0 calc(8 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(6 * var(--u));
    background: var(--m-rail-bg);
    box-shadow: inset -1px 0 0 var(--m-rail-edge);
    color: var(--m-text-dim);
    overflow: hidden;
  }
  .rail-glow {
    position: absolute;
    left: -30%;
    top: calc(-108 * var(--u));
    width: 160%;
    height: calc(324 * var(--u));
    background: radial-gradient(at 50% 0%, var(--m-glass-spot), transparent 72%);
    pointer-events: none;
  }
  .rb {
    position: relative;
    width: calc(40 * var(--u));
    height: calc(40 * var(--u));
    display: grid;
    place-items: center;
  }
  .rb + .rb {
    margin-top: calc(1 * var(--u));
  }
  .rb :global(.rail-mark) {
    width: calc(20 * var(--u));
    height: calc(20 * var(--u));
    color: var(--m-accent);
  }
  .ri {
    width: calc(20 * var(--u));
    height: calc(20 * var(--u));
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rail-rule {
    width: calc(22 * var(--u));
    height: 1px;
    margin: calc(10 * var(--u)) 0 calc(8 * var(--u));
    background: var(--m-border-subtle);
  }
  .rail-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(4 * var(--u));
  }
  .you {
    width: calc(24 * var(--u));
    height: calc(24 * var(--u));
    border-radius: 50%;
    border: 1px solid var(--m-border);
    display: grid;
    place-items: center;
    font-size: calc(11 * var(--u));
    font-weight: 600;
    color: var(--m-text);
  }

  /* ---- pane: frame bar + page ---- */
  .pane {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .topbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: calc(54 * var(--u));
    padding: 0 calc(32 * var(--u));
    font-size: max(9px, calc(12.5 * var(--u)));
    color: var(--m-text-dim);
    white-space: nowrap;
  }
  .topbar::after {
    content: "";
    position: absolute;
    inset-inline: 6%;
    bottom: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--m-border-subtle) 12%, var(--m-border-subtle) 88%, transparent);
  }
  .tb-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    text-transform: lowercase;
  }
  .tb-dot {
    width: max(4px, calc(6 * var(--u)));
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--m-accent);
    box-shadow: 0 0 6px var(--m-accent);
  }
  .tb-sep {
    opacity: 0.6;
  }
  .tb-focus {
    text-transform: none;
    margin-left: 0.5em;
  }

  .page {
    position: relative;
    flex: 1;
    padding: calc(44 * var(--u)) calc(64 * var(--u)) calc(28 * var(--u));
    background: var(--m-glow);
  }
  .col {
    max-width: calc(672 * var(--u));
    margin: 0 auto;
  }

  .ed-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: calc(42.7 * var(--u));
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--m-heading);
    padding-bottom: calc(30 * var(--u));
    margin: 0;
  }
  .ed-line,
  .ed-slash {
    font-family: var(--font-body);
    font-optical-sizing: auto;
    font-size: calc(24 * var(--u));
    line-height: 1.7;
    color: var(--m-text);
    margin: 0;
  }
  .ed-line {
    min-height: 1.7em;
  }

  .caret {
    display: inline-block;
    width: max(1.5px, calc(2 * var(--u)));
    height: 1.15em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--m-accent);
    animation: appw-blink 1.05s steps(1) infinite;
  }
  .caret[hidden] {
    display: none;
  }
  @keyframes appw-blink {
    50% { opacity: 0; }
  }

  /* ---- a verse, set in the page ---- */
  .ed-verse {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ed-verse[data-verse="hidden"] {
    grid-template-rows: 0fr;
  }
  .ev-clip {
    min-height: 0;
    overflow: hidden;
  }
  .ev-block {
    position: relative;
    padding: calc(6.5 * var(--u)) calc(25 * var(--u)) calc(5 * var(--u)) calc(13.6 * var(--u));
  }
  .ev-rule {
    position: absolute;
    left: 0;
    top: calc(6.5 * var(--u));
    bottom: calc(5 * var(--u));
    width: 1px;
    background: color-mix(in srgb, var(--m-accent) 32%, transparent);
    transform-origin: top;
  }
  .ev-text {
    font-family: var(--font-body);
    font-style: italic;
    font-optical-sizing: auto;
    font-size: calc(21.6 * var(--u));
    line-height: 1.7;
    letter-spacing: 0.005em;
    color: var(--m-text);
    margin: 0;
  }
  .ev-w {
    display: inline-block;
    white-space: pre;
  }
  .ev-cite {
    font-family: var(--label);
    font-weight: 500;
    font-size: calc(15.8 * var(--u));
    line-height: 1.7;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-variant-numeric: lining-nums proportional-nums;
    color: var(--m-text-faint);
    margin: 0;
  }
  .ev-ref {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--m-accent) 45%, transparent);
    text-underline-offset: 0.35em;
  }
  .ev-door {
    display: inline-block;
    margin-left: 0.36em;
    font-size: 0.72em;
    letter-spacing: 0;
  }

  /* ---- the line being written into ---- */
  .ed-slash {
    position: relative;
    min-height: 1.7em;
  }
  .ed-slash[data-slash="off"] {
    display: none;
  }
  .gutter-plus {
    position: absolute;
    left: calc(-28 * var(--u));
    top: 0;
    font-family: var(--sans);
    font-weight: 300;
    font-size: calc(18 * var(--u));
    line-height: calc(40.8 * var(--u));
    color: var(--m-text-faint);
  }

  /* ---- the `/` palette ---- */
  .palette,
  .popover {
    position: absolute;
    left: calc(9 * var(--u));
    top: calc(100% + 1 * var(--u));
    z-index: 4;
    opacity: 0;
    visibility: hidden;
    transform: translateY(calc(-6 * var(--u))) scale(0.985);
    transform-origin: top left;
    filter: blur(2px);
    transition:
      opacity 0.2s ease,
      transform 0.26s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.26s ease,
      visibility 0s linear 0.26s;
  }
  .palette[data-open],
  .popover[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    filter: none;
    transition-delay: 0s;
  }

  .palette {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: calc(4 * var(--pu));
    width: min(calc(440 * var(--pu)), 100%);
    height: calc(300 * var(--pu));
    padding: calc(4.8 * var(--pu));
    border-radius: calc(14 * var(--pu));
    overflow: hidden;
    background: var(--m-glass-bg);
    border: 1px solid var(--m-glass-border);
    box-shadow:
      var(--m-glass-shadow),
      var(--m-glass-shadow-glow),
      inset 0 1px 0 var(--m-glass-edge);
    backdrop-filter: blur(22px) saturate(1.12);
    -webkit-backdrop-filter: blur(22px) saturate(1.12);
    font-family: var(--sans);
  }
  .pal-glow {
    position: absolute;
    right: -12%;
    top: -38%;
    width: 58%;
    height: 78%;
    background: radial-gradient(circle at 45% 45%, var(--m-glass-spot), transparent 68%);
    pointer-events: none;
  }
  .pal-col {
    min-width: 0;
  }
  .pal-head {
    padding: calc(4.8 * var(--pu)) calc(9.6 * var(--pu)) calc(4 * var(--pu));
    font-size: calc(10.24 * var(--pu));
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--m-text-dim);
  }
  .pal-item {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: calc(8.8 * var(--pu));
    min-height: calc(40 * var(--pu));
    padding: calc(6.4 * var(--pu)) calc(8.8 * var(--pu));
    border-radius: calc(10 * var(--pu));
    transition: transform 0.14s ease;
  }
  .pal-item.is-active {
    background: var(--m-bg-hover);
  }
  .pal-item.is-pressed {
    transform: scale(0.97);
  }
  /* once the script drives it, one highlight glides between rows */
  .palette.has-hi .pal-item.is-active {
    background: none;
  }
  .pal-hi {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 0;
    border-radius: calc(10 * var(--pu));
    background: var(--m-bg-hover);
    opacity: 0;
    transition:
      transform 0.24s cubic-bezier(0.3, 0.7, 0.2, 1),
      width 0.24s cubic-bezier(0.3, 0.7, 0.2, 1),
      height 0.24s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .palette.has-hi .pal-hi {
    opacity: 1;
  }
  .pal-badge {
    flex: none;
    width: calc(27 * var(--pu));
    height: calc(27 * var(--pu));
    display: grid;
    place-items: center;
    border-radius: calc(7 * var(--pu));
    background: color-mix(in srgb, var(--m-bg-input) 70%, transparent);
    border: 1px solid var(--m-bg-hover);
    font-family: var(--font-mono);
    font-size: calc(11.5 * var(--pu));
    line-height: 1;
    color: var(--m-text-bright);
  }
  .pal-badge.is-bold {
    font-weight: 700;
  }
  .pal-badge.is-italic {
    font-style: italic;
  }
  .pal-badge svg {
    width: calc(15 * var(--pu));
    height: calc(15 * var(--pu));
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pal-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pal-label {
    font-size: calc(13.1 * var(--pu));
    letter-spacing: 0.01em;
    line-height: 1.25;
    color: var(--m-text-bright);
  }
  .pal-hint {
    font-size: calc(11.5 * var(--pu));
    line-height: 1.3;
    color: var(--m-text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- what Scripture opens ---- */
  .popover {
    display: flex;
    flex-direction: column;
    width: min(calc(420 * var(--pu)), 100%);
    padding: calc(4.8 * var(--pu));
    border-radius: calc(14 * var(--pu));
    background: var(--m-bg-elevated);
    border: 0.5px solid var(--m-border);
    box-shadow: var(--m-pop-shadow);
    font-family: var(--sans);
  }
  .pop-chrome {
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--pu));
    padding: calc(8.8 * var(--pu)) calc(11.2 * var(--pu));
    margin: calc(-4.8 * var(--pu)) calc(-4.8 * var(--pu)) calc(4 * var(--pu));
    border-bottom: 0.5px solid var(--m-border-subtle);
  }
  .pop-label {
    font-family: var(--font-mono);
    font-size: calc(11 * var(--pu));
    letter-spacing: 0.02em;
    color: var(--m-text-faint);
  }
  .pop-search {
    font-size: calc(13 * var(--pu));
    color: var(--m-text-faint);
  }
  .pop-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pop-result {
    padding: calc(9.6 * var(--pu)) calc(11.2 * var(--pu));
    border-radius: calc(8 * var(--pu));
    transition: background 0.18s ease, transform 0.14s ease;
  }
  .pop-result.is-active {
    background: var(--m-accent-soft);
  }
  .pop-result.is-pressed {
    transform: scale(0.985);
  }
  .pop-ref {
    display: block;
    font-family: var(--font-mono);
    font-size: calc(11 * var(--pu));
    color: var(--m-text-faint);
    margin-bottom: calc(3 * var(--pu));
  }
  .pop-result.is-active .pop-ref {
    color: var(--m-accent);
  }
  .pop-verse {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: calc(15 * var(--pu));
    line-height: 1.5;
    color: var(--m-text-bright);
  }
  .pop-loading {
    display: none;
    padding: calc(10 * var(--pu)) calc(11.2 * var(--pu));
  }
  .pop-loading span {
    display: block;
    height: calc(8.8 * var(--pu));
    width: 94%;
    margin-bottom: calc(4.5 * var(--pu));
    border-radius: 4px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--m-border-subtle) 55%, var(--m-bg-elevated)) 0%,
      color-mix(in srgb, var(--m-border) 40%, var(--m-bg-elevated)) 45%,
      color-mix(in srgb, var(--m-border-subtle) 55%, var(--m-bg-elevated)) 90%
    );
    background-size: 220% 100%;
    animation: appw-shimmer 1.15s ease-in-out infinite;
  }
  .pop-loading span.short {
    width: 62%;
    margin-bottom: calc(14 * var(--pu));
  }
  @keyframes appw-shimmer {
    from { background-position: 100% 0; }
    to { background-position: -120% 0; }
  }
  .popover[data-state="loading"] .pop-loading {
    display: block;
  }
  .popover[data-state="loading"] .pop-results {
    display: none;
  }
  .pop-foot {
    padding: calc(6.4 * var(--pu)) calc(11.2 * var(--pu)) calc(2.4 * var(--pu));
    margin-top: calc(3.2 * var(--pu));
    border-top: 0.5px solid var(--m-border-subtle);
    font-family: var(--font-mono);
    font-size: calc(10 * var(--pu));
    letter-spacing: 0.02em;
    color: var(--m-text-faint);
  }

  /* ---- motion: only once the script has taken the mock over ---- */
  .appw[data-motion] .pop-result {
    animation: appw-rise 0.42s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 80ms);
  }
  .appw[data-motion] .ed-verse[data-verse="hidden"] .ev-w,
  .appw[data-motion] .ed-verse[data-verse="hidden"] .ev-cite {
    opacity: 0;
  }
  .appw[data-motion] .ed-verse[data-verse="hidden"] .ev-rule {
    transform: scaleY(0);
  }
  .appw[data-motion] .ed-verse[data-verse="set"] .ev-w {
    animation: appw-word 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(140ms + var(--i) * 38ms);
  }
  .appw[data-motion] .ed-verse[data-verse="set"] .ev-rule {
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s;
  }
  .appw[data-motion] .ed-verse[data-verse="set"] .ev-cite {
    animation: appw-fade 0.7s ease both 0.85s;
  }
  /* the light the verse brings: a warm wash through the words as they land.
     On .ed-verse, not inside .ev-clip, so the reveal doesn't crop it square. */
  .ed-verse {
    position: relative;
  }
  .appw[data-motion] .ed-verse[data-verse="set"]::before {
    content: "";
    position: absolute;
    inset: -70% -12% -70% -18%;
    background: radial-gradient(closest-side, var(--m-bloom), transparent);
    pointer-events: none;
    animation: appw-flare 2.8s ease-out both 0.2s;
  }
  @keyframes appw-rise {
    from { opacity: 0; transform: translateY(calc(6 * var(--u))); }
    to { opacity: 1; transform: none; }
  }
  @keyframes appw-word {
    from { opacity: 0; filter: blur(5px); transform: translateY(0.25em); }
    to { opacity: 1; filter: blur(0); transform: none; }
  }
  @keyframes appw-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes appw-flare {
    0% { opacity: 0; }
    25% { opacity: 1; }
    100% { opacity: 0; }
  }

  /* a halo behind the window, lit when the verse lands */
  .appw-bloom {
    position: absolute;
    inset: 12% 8% 18%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 45%, var(--dawn-1), transparent 70%);
    filter: blur(40px);
    opacity: 0;
    pointer-events: none;
  }
  .appw-frame.is-lit .appw-bloom {
    animation: appw-bloom 3.2s ease-out forwards;
  }
  @keyframes appw-bloom {
    0% { opacity: 0; }
    30% { opacity: 0.5; }
    100% { opacity: 0.16; }
  }

  /* ---- narrow (half-width column, phone): the page only, re-based so the
     writing stays legible once the rail is gone ---- */
  @container appw (max-width: 600px) {
    .appw {
      --u: calc(100cqi / 720);
      --pu: calc(var(--u) * 1.2);
    }
    .rail,
    .tb-focus {
      display: none;
    }
    .appw-main {
      min-height: calc(740 * var(--u));
    }
    .palette {
      height: calc(262 * var(--pu));
    }
    .topbar {
      padding: 0 calc(24 * var(--u));
      font-size: max(9px, calc(14 * var(--u)));
    }
    .page {
      padding: calc(40 * var(--u)) calc(40 * var(--u)) calc(24 * var(--u));
    }
    .gutter-plus {
      left: calc(-26 * var(--u));
    }
    .palette,
    .popover {
      left: 0;
    }
  }
  @container appw (max-width: 440px) {
    .appw {
      --u: calc(100cqi / 600);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .palette,
    .popover,
    .ed-verse {
      transition: none;
    }
    .caret {
      animation: none;
    }
  }
</style>

<script>
  // The gesture, once: write a line, `/`, Scripture, the passage found from
  // what was written, set — then `/` again, resting on the next thing a writer
  // might reach for. The markup is already the last frame, so this script only
  // has to rewind it and play forward; nothing here is needed for the picture.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const countWords = (s: string) => s.trim().split(/\s+/).filter(Boolean).length;

  function setup(frame: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(sel: string) => frame.querySelector<T & HTMLElement>(sel)!;
    const appw = $(".appw");
    const typed = $("[data-typed]");
    const lineCaret = $("[data-line-caret]");
    const slash = $("[data-slash]");
    const slashCh = $("[data-slash-ch]");
    const palette = $("[data-palette]");
    const hi = $("[data-hi]");
    const popover = $("[data-popover]");
    const results = [...frame.querySelectorAll<HTMLElement>("[data-result]")];
    const verse = $("[data-verse]");
    const count = $("[data-count]");
    const items = [...palette.querySelectorAll<HTMLElement>("[data-item]")];

    const line = typed.textContent ?? "";
    const titleWords = Number(frame.dataset.titleWords) || 0;
    const rest = frame.dataset.rest || "pray";
    const firstFormat = items[0]?.dataset.item ?? "";

    // Glide the one highlight to a row. Offsets, not client rects: the hero
    // tilts the window in 3D, and offsets are measured before the transform.
    const activate = (id: string) => {
      const el = items.find((i) => i.dataset.item === id);
      if (!el) return;
      items.forEach((i) => i.classList.toggle("is-active", i === el));
      const col = el.offsetParent === palette ? null : (el.offsetParent as HTMLElement | null);
      const x = el.offsetLeft + (col?.offsetLeft ?? 0);
      const y = el.offsetTop + (col?.offsetTop ?? 0);
      hi.style.transform = `translate(${x}px, ${y}px)`;
      hi.style.width = `${el.offsetWidth}px`;
      hi.style.height = `${el.offsetHeight}px`;
    };
    const press = async (el: HTMLElement | undefined) => {
      el?.classList.add("is-pressed");
      await sleep(150);
      el?.classList.remove("is-pressed");
    };
    const openPalette = () => {
      // Seat the highlight on the first row without gliding there from
      // wherever the last opening left it; only moves after this glide.
      hi.style.transition = "none";
      activate(firstFormat);
      void hi.offsetWidth;
      hi.style.transition = "";
      palette.classList.add("has-hi");
      palette.toggleAttribute("data-open", true);
    };

    // Rewind to the empty line.
    appw.dataset.motion = "";
    typed.textContent = "";
    lineCaret.hidden = false;
    count.textContent = String(titleWords);
    verse.dataset.verse = "hidden";
    slash.dataset.slash = "off";
    slashCh.textContent = "";
    palette.toggleAttribute("data-open", false);
    popover.toggleAttribute("data-open", false);
    popover.dataset.state = "loading";
    results.forEach((r, i) => r.classList.toggle("is-active", i === 0));

    return async function play() {
      // write the line, at a hand's pace
      for (let i = 0; i < line.length; i++) {
        const ch = line[i]!;
        typed.textContent += ch;
        count.textContent = String(titleWords + countWords(typed.textContent ?? ""));
        await sleep(ch === "." ? 240 : ch === " " ? 48 : 22 + Math.random() * 30);
      }
      await sleep(420);

      // a new line, and `/`
      lineCaret.hidden = true;
      slash.dataset.slash = "on";
      await sleep(380);
      slashCh.textContent = "/";
      openPalette();
      await sleep(640);
      activate("scripture");
      await sleep(720);
      await press(items.find((i) => i.dataset.item === "scripture"));

      // Scripture: passages found from what was written
      palette.toggleAttribute("data-open", false);
      slashCh.textContent = "";
      popover.dataset.state = "loading";
      popover.toggleAttribute("data-open", true);
      await sleep(820);
      popover.dataset.state = "ready";
      await sleep(1250);
      await press(results[0]);

      // set in the page
      popover.toggleAttribute("data-open", false);
      slash.dataset.slash = "off";
      verse.dataset.verse = "set";
      frame.classList.add("is-lit");
      await sleep(1700);

      // and the next thing to reach for
      slash.dataset.slash = "on";
      await sleep(420);
      slashCh.textContent = "/";
      openPalette();
      await sleep(560);
      activate("scripture");
      await sleep(360);
      activate(rest);
    };
  }

  if (!reduce && "IntersectionObserver" in window) {
    document.querySelectorAll<HTMLElement>("[data-appw][data-play]").forEach((frame) => {
      const play = setup(frame);
      // Begin as the window finishes arriving (the hero brings it in ~1.1s
      // after load), and only once the faces it measures have landed.
      const notBefore = 1900;
      const io = new IntersectionObserver(
        async (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          await document.fonts?.ready;
          await sleep(Math.max(0, notBefore - performance.now()));
          await play();
        },
        { threshold: 0.35 },
      );
      io.observe(frame);
    });
  }
</script>
