---
// AppMock — a native HTML/CSS recreation of the actual Dayspring desktop app:
// a left icon rail, the entries sidebar (brand, search, list with an active
// row), and the editor pane (status bar, a gold entry title, prose with a
// blinking caret) plus the "+" FAB. Not a screenshot — real markup, so it
// stays crisp and themed to First Light. Content is tasteful marketing copy.
//
// Collapses to the editor pane only in narrow containers (container query),
// so it reads well in a half-width feature column and on mobile.
import Mark from "./Mark.astro";

interface Entry {
  title: string;
  meta: string; // e.g. "Mar 14 · 120 w"
  active?: boolean;
}
interface SlashCommand {
  id: string;
  label: string;
  hint: string;
}
interface SlashState {
  typed: string;
  activeId: string;
  commands?: SlashCommand[];
}
interface Props {
  brand?: string;
  count?: string; // "ENTRIES · 511"
  entries?: Entry[];
  open?: {
    date: string; // editor top-left, e.g. "march 14"
    status: string; // e.g. "112 words · saved just now · synced"
    title: string; // gold entry title
    body: string[]; // paragraphs
    /** Inline /scripture insert — shows the spiritual life in the sentence. */
    scripture?: { ref: string; text: string };
  };
  /** In-editor slash palette (hero differentiator). */
  slash?: SlashState;
  class?: string;
}

const defaultSlashCommands: SlashCommand[] = [
  { id: "scripture", label: "/scripture", hint: "Find relevant Bible passages" },
  { id: "pray", label: "/pray", hint: "Log a prayer" },
  { id: "sense", label: "/sense", hint: "Record a word or impression" },
  { id: "ritual", label: "/ritual", hint: "Rituals for the inner life" },
  { id: "image", label: "/image", hint: "Add a photo to this entry" },
];

const {
  brand = "Dayspring",
  count = "Entries · 511",
  entries = [
    { title: "Hard conversation with Marcus", meta: "Mar 14 · 120 w", active: true },
    { title: "Morning, before the house woke", meta: "Mar 13 · 240 w" },
    { title: "What I keep circling back to", meta: "Mar 11 · 90 w" },
    { title: "On the long drive home", meta: "Mar 9 · 310 w" },
    { title: "Gratitude, even today", meta: "Mar 8 · 75 w" },
    { title: "A prayer I almost didn't write", meta: "Mar 6 · 180 w" },
    { title: "Here at the table", meta: "Mar 3 · 60 w" },
    { title: "Untitled", meta: "Mar 2 · 0 w" },
  ],
  open = {
    date: "march 14",
    status: "112 words · saved just now · synced",
    title: "Hard conversation with Marcus",
    body: [
      "I went in defensive and left grateful — not sure when that shifted.",
      "I've been praying about patience for months now. Maybe this was an answer I almost walked past.",
    ],
  },
  slash,
  class: className = "",
} = Astro.props;

const slashCommands = slash?.commands ?? defaultSlashCommands;
const slashActive = slash?.activeId ?? slashCommands[0]?.id;
---

<div class:list={["appw", className]}>
  <div class="traffic" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="appw-main">
    {/* nav rail — Write / Return, matching the app */}
    <nav class="rail" aria-hidden="true">
      <div class="rail-brand">
        <Mark size={18} />
        <span>{brand}</span>
      </div>

      <div class="rail-group">
        <span class="rail-glabel">Write</span>
        <span class="rail-item">
          <svg class="ri" viewBox="0 0 24 24"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
          <em>New entry</em>
        </span>
        <span class="rail-item active">
          <svg class="ri" viewBox="0 0 24 24"><path d="M9 6h11" /><path d="M9 12h11" /><path d="M9 18h11" /><path d="M4.5 6h.01" /><path d="M4.5 12h.01" /><path d="M4.5 18h.01" /></svg>
          <em>Entries</em>
        </span>
      </div>

      <div class="rail-group">
        <span class="rail-glabel">Return</span>
        <span class="rail-item">
          <svg class="ri" viewBox="0 0 24 24"><path d="M3 19h18" /><path d="M6 19l4-8.5 3 4.5 2.5-3.5L19 19" /></svg>
          <em>Ascent</em>
        </span>
        <span class="rail-item">
          <svg class="ri" viewBox="0 0 24 24"><path d="M12 7v13" /><path d="M3 18a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4a4 4 0 0 1 5 3 4 4 0 0 1 5-3h4a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-5a3 3 0 0 0-4 1 3 3 0 0 0-4-1z" /></svg>
          <em>Lamp</em>
        </span>
        <span class="rail-item">
          <svg class="ri" viewBox="0 0 24 24"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" /></svg>
          <em>Altar</em>
        </span>
      </div>

      <div class="rail-foot">
        <span class="rail-item">
          <svg class="ri" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V15z" /></svg>
          <em>Settings</em>
        </span>
        <span class="rail-item">
          <svg class="ri" viewBox="0 0 24 24"><path d="M5 7h14" /><path d="M5 12h14" /><path d="M5 17h14" /></svg>
          <em>Collapse</em>
        </span>
      </div>
    </nav>

    {/* entries list */}
    <aside class="side">
      <div class="side-search">Search entries…</div>
      <div class="side-views">
        <span class="sv on">List</span>
        <span class="sv">Month</span>
        <span class="sv">Year</span>
      </div>
      <div class="side-daygroup">Today</div>
      <ul class="side-list">
        {
          entries.map((e) => (
            <li class:list={["entry", { active: e.active }]}>
              <span class="e-title">{e.title}</span>
              <span class="e-meta">{e.meta}</span>
            </li>
          ))
        }
      </ul>
    </aside>

    {/* editor pane */}
    <section class="editor">
      <div class="ed-top">
        <span class="ed-date">{open.date}</span>
        <span class="ed-status">
          <span class="dot" aria-hidden="true"></span>{open.status}
          <span class="ed-focus">focus</span>
        </span>
      </div>
      <h3 class="ed-title">{open.title}</h3>
      <div class="ed-body">
        {
          open.body.map((p, i) => (
            <p>
              {p}
              {!slash && !open.scripture && i === open.body.length - 1 && (
                <span class="caret" />
              )}
            </p>
          ))
        }
        {
          !slash && open.scripture && (
            <blockquote class="ed-scripture">
              <p class="es-text">{open.scripture.text}</p>
              <p class="es-ref mono">
                {open.scripture.ref} · ESV<span class="caret" />
              </p>
            </blockquote>
          )
        }
        {
          slash && (
            <div class="ed-slash">
              <p class="slash-line">
                <span class="slash-token">{slash.typed}</span>
                <span class="caret" aria-hidden="true" />
              </p>
              <nav class="slash-palette" aria-label="Slash commands">
                {
                  slashCommands.map((cmd) => (
                    <div
                      class:list={[
                        "slash-item",
                        { active: cmd.id === slashActive },
                      ]}
                    >
                      <span class="slash-label">{cmd.label}</span>
                      <span class="slash-hint">{cmd.hint}</span>
                    </div>
                  ))
                }
              </nav>
            </div>
          )
        }
      </div>
      <span class="fab" aria-hidden="true">+</span>
    </section>
  </div>
</div>

<style>
  .appw {
    container-type: inline-size;
    position: relative;
    background: var(--ink-2);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 50px 100px -45px var(--shadow);
  }

  /* macOS traffic lights — First Light tinted */
  .traffic {
    position: absolute;
    top: 15px;
    left: 16px;
    z-index: 3;
    display: flex;
    gap: 7px;
  }
  .traffic i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    opacity: 0.65;
  }
  .traffic i:nth-child(1) { background: #e8917c; }
  .traffic i:nth-child(2) { background: #f3bd76; }
  .traffic i:nth-child(3) { background: #9fcf8f; }

  .appw-main {
    display: flex;
    min-height: 460px;
  }

  /* ---- nav rail (Write / Return) ---- */
  .rail {
    flex: none;
    width: 156px;
    border-right: 1px solid var(--border);
    padding: 40px 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .rail-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--paper);
    padding-left: 8px;
    margin-bottom: 2px;
  }
  .rail-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .rail-glabel {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 8px;
    margin-bottom: 8px;
  }
  .rail-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 8px;
    color: var(--paper-dim);
  }
  .rail-item .ri {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rail-item em {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 13.5px;
    letter-spacing: 0.1px;
  }
  .rail-item.active {
    color: var(--dawn-1);
    background: var(--accent-glow);
  }
  .rail-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .rail-foot .rail-item {
    color: var(--muted);
  }

  /* ---- entries list column ---- */
  .side {
    flex: none;
    width: 210px;
    border-right: 1px solid var(--border);
    padding: 42px 16px 16px;
    overflow: hidden;
  }
  .side-search {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 9px 12px;
    margin-bottom: 14px;
  }
  .side-views {
    display: flex;
    gap: 4px;
    margin-bottom: 18px;
  }
  .side-views .sv {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.3px;
    color: var(--muted);
    padding: 4px 9px;
    border-radius: 7px;
  }
  .side-views .sv.on {
    color: var(--dawn-1);
    background: var(--accent-glow);
  }
  .side-daygroup {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .side-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 9px 12px;
    margin: 0 -12px;
    border-left: 2px solid transparent;
  }
  .entry.active {
    background: rgba(243, 189, 118, 0.07);
    border-left-color: var(--dawn-1);
  }
  .e-title {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--paper-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .entry.active .e-title {
    color: var(--paper);
  }
  .e-meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    letter-spacing: 0.3px;
  }

  /* ---- editor ---- */
  .editor {
    position: relative;
    flex: 1;
    padding: 16px 38px 38px;
    min-width: 0;
  }
  .editor:has(.ed-slash) {
    padding-bottom: clamp(150px, 20vh, 210px);
  }
  .ed-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    margin-bottom: 44px;
  }
  .ed-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .ed-status .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dawn-1);
    box-shadow: 0 0 8px 0 rgba(243, 189, 118, 0.6);
  }
  .ed-focus {
    color: var(--paper-dim);
    margin-left: 6px;
  }
  .ed-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 3.2vw, 30px);
    letter-spacing: -0.4px;
    line-height: 1.1;
    color: var(--dawn-1);
    margin-bottom: 26px;
  }
  .ed-body p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.75;
    color: var(--paper);
    font-weight: 300;
    margin-bottom: 14px;
    max-width: 60ch;
  }
  .ed-body .caret {
    display: inline-block;
    width: 8px;
    height: 18px;
    vertical-align: -3px;
    background: var(--dawn-1);
    margin-left: 2px;
    animation: appw-blink 1.1s steps(1) infinite;
  }
  @keyframes appw-blink {
    50% { opacity: 0; }
  }

  /* ---- inline /scripture insert ---- */
  .ed-scripture {
    margin: 4px 0 14px;
    padding-left: 18px;
    border-left: 2px solid var(--dawn-1);
    max-width: 60ch;
  }
  .ed-scripture .es-text {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 16px;
    line-height: 1.65;
    color: var(--paper-dim);
    margin: 0 0 6px;
    font-weight: 300;
  }
  .ed-scripture .es-ref {
    font-size: 10.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  /* ---- slash palette (hero / feature mocks) ---- */
  .ed-slash {
    position: relative;
    margin-top: 6px;
  }
  .slash-line {
    margin-bottom: 0;
  }
  .slash-token {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--dawn-1);
    letter-spacing: -0.2px;
  }
  .slash-palette {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 10px;
    z-index: 4;
    width: min(100%, 300px);
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--ink-2);
    border: 1px solid var(--border-strong);
    box-shadow: 0 10px 28px -14px var(--shadow);
  }
  .slash-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid transparent;
  }
  .slash-item.active {
    background: rgba(243, 189, 118, 0.1);
    border-color: rgba(243, 189, 118, 0.22);
  }
  .slash-label {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--paper-dim);
  }
  .slash-item.active .slash-label {
    color: var(--dawn-1);
  }
  .slash-hint {
    font-size: 12px;
    line-height: 1.45;
    color: var(--muted);
    font-weight: 300;
  }
  .slash-item.active .slash-hint {
    color: var(--paper-dim);
  }

  .fab {
    position: absolute;
    right: 22px;
    bottom: 22px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 26px;
    line-height: 1;
    color: var(--ink);
    background: radial-gradient(circle at 35% 30%, var(--dawn-1), var(--dawn-3));
    box-shadow: 0 10px 26px -6px rgba(243, 189, 118, 0.55);
  }

  /* narrow container (half-width feature column, mobile): editor only */
  @container (max-width: 600px) {
    .rail,
    .side {
      display: none;
    }
    .editor {
      padding: 18px 22px 30px;
    }
    .ed-top {
      margin-bottom: 28px;
    }
    .slash-palette {
      width: 100%;
      max-width: 280px;
    }
    .slash-label {
      font-size: 12px;
    }
    .slash-hint {
      font-size: 11px;
    }
  }
</style>
