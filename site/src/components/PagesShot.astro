---
// PagesShot — a real screenshot of the read surface, in a Mac window frame.
//
// The only photographic asset on the site; every other product visual here is
// a CSS recreation (see SCREENSHOTS.md). This one earns it: the wall's density
// — a decade of pages at four columns, with `look for` open over it — is the
// whole argument, and no honest recreation of it would be smaller than the
// capture.
//
// Both palettes are captured, because the site has a theme toggle and a
// parchment screenshot on an ink page reads as a bug.
//
// And both CROPS are captured, because a 1280px desktop surface reduced to a
// 335px phone column is a grey smudge — the point of the section becomes
// invisible exactly where most visitors are. So a phone gets the `look for`
// panel at its native width inside a swipeable box: fewer pixels of the app,
// but every one of them legible. `scripts/capture-site-shots.mjs` writes all
// eight files; re-run it when the surface changes.
interface Props {
  alt: string;
  /** Mono hint under the phone crop, telling a thumb the box moves. */
  swipeHint?: string;
  class?: string;
}
const {
  alt,
  swipeHint = "swipe to read across →",
  class: className = "",
} = Astro.props;

// Intrinsic sizes of the two captures — passed through so each box reserves
// its space and nothing shifts when the image lands.
const FULL = { w: 1280, h: 1020 };
const PANEL = { w: 1280, h: 540 };
---

<figure class:list={["shot", className]}>
  <div class="chrome" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="rail">
    <img
      class="shot-img is-full is-dark"
      src="/screenshots/pages-search-dark.png"
      srcset="/screenshots/pages-search-dark.png 1x, /screenshots/pages-search-dark@2x.png 2x"
      width={FULL.w}
      height={FULL.h}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
    <img
      class="shot-img is-full is-light"
      src="/screenshots/pages-search-light.png"
      srcset="/screenshots/pages-search-light.png 1x, /screenshots/pages-search-light@2x.png 2x"
      width={FULL.w}
      height={FULL.h}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
    <img
      class="shot-img is-panel is-dark"
      src="/screenshots/pages-search-dark-panel.png"
      srcset="/screenshots/pages-search-dark-panel.png 1x, /screenshots/pages-search-dark-panel@2x.png 2x"
      width={PANEL.w}
      height={PANEL.h}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
    <img
      class="shot-img is-panel is-light"
      src="/screenshots/pages-search-light-panel.png"
      srcset="/screenshots/pages-search-light-panel.png 1x, /screenshots/pages-search-light-panel@2x.png 2x"
      width={PANEL.w}
      height={PANEL.h}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
  </div>
</figure>
<p class="swipe-hint mono" aria-hidden="true">{swipeHint}</p>

<style>
  .shot {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    overflow: hidden;
    background: var(--ink-2);
    box-shadow:
      0 60px 120px -50px var(--shadow),
      0 0 90px -45px var(--accent-glow);
    margin: 0;
  }

  /* A slim title bar, because the point of this section is now "install it".
     The app itself hides its titlebar and floats the lights over the content —
     which is exactly where the `look for` pill sits, so here they get a strip
     of their own rather than sitting on top of the control being advertised. */
  .chrome {
    display: flex;
    gap: 7px;
    align-items: center;
    height: 34px;
    padding: 0 15px;
    background: var(--ink-3);
    border-bottom: 1px solid var(--border);
  }
  .chrome i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    opacity: 0.65;
  }
  .chrome i:nth-child(1) {
    background: #e8917c;
  }
  .chrome i:nth-child(2) {
    background: #f3bd76;
  }
  .chrome i:nth-child(3) {
    background: #9fcf8f;
  }

  .shot-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Two axes of choice: palette (the theme toggle sets data-theme on <html>,
     dark being the default) and crop (width). Everything is hidden by default
     and one combination is switched back on, which is shorter than writing the
     four negations. */
  .shot-img {
    display: none;
  }
  .shot-img.is-full.is-dark {
    display: block;
  }
  :global([data-theme="light"]) .shot-img.is-full.is-dark {
    display: none;
  }
  :global([data-theme="light"]) .shot-img.is-full.is-light {
    display: block;
  }

  .swipe-hint {
    display: none;
  }

  /* Phone: the panel, at 1 CSS px per captured px, in a scroller. Anything
     that fits the whole surface into the column is too small to read. */
  @media (max-width: 760px) {
    .rail {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .rail::-webkit-scrollbar {
      display: none;
    }
    .shot-img {
      width: 1280px;
      max-width: none;
    }
    .shot-img.is-full.is-dark,
    :global([data-theme="light"]) .shot-img.is-full.is-light {
      display: none;
    }
    .shot-img.is-panel.is-dark {
      display: block;
    }
    :global([data-theme="light"]) .shot-img.is-panel.is-dark {
      display: none;
    }
    :global([data-theme="light"]) .shot-img.is-panel.is-light {
      display: block;
    }

    .swipe-hint {
      display: block;
      margin-top: 10px;
      font-size: 10.5px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: var(--muted);
    }
  }
</style>
