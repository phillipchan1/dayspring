---
// Hero — copy left, product right: expansive at first glance, not a phone
// floating under centered text. Dawn sits behind the mock; on small screens
// we stack with a soft backdrop so the journal still reads immediately.
import type { ComponentProps } from "astro/types";
import AppMock from "./AppMock.astro";

interface Props {
  eyebrow: string;
  lines: string[];
  sub: string;
  verse: { text: string; ref: string };
  primary: { label: string; href: string };
  ghost: { label: string; href: string };
  /** Secondary Mac download — rendered quietly and hidden at phone width. */
  macos?: { label: string; href: string };
  note?: string;
  mockCaption?: string;
  appMock?: ComponentProps<typeof AppMock>;
}
const {
  eyebrow,
  lines,
  sub,
  verse,
  primary,
  ghost,
  macos,
  note,
  mockCaption,
  appMock = {},
} = Astro.props;
---

<header class="hero-product">
  <div class="dawn" id="dawn" aria-hidden="true"></div>
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="hero-shell">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{eyebrow}</p>
        <h1>
          {lines.map((line) => <span class="l" set:html={line} />)}
        </h1>
        <p class="sub">{sub}</p>
        <p class="verse mono">
          &ldquo;{verse.text}&rdquo; — {verse.ref}
        </p>
        <div class="actions">
          <a href={primary.href} class="btn btn-primary">{primary.label}</a>
          <a href={ghost.href} class="btn btn-ghost">{ghost.label}</a>
        </div>
        {
          (note || macos) && (
            <p class="cta-note">
              {note && <span>{note}</span>}
              {note && macos && <span class="macos-only"> · </span>}
              {macos && (
                <a href={macos.href} class="macos-only macos-link">
                  {macos.label}
                </a>
              )}
            </p>
          )
        }
      </div>

      <div class="hero-visual">
        <div class="hero-mock" aria-hidden="true">
          <AppMock {...appMock} class="hero-appw" />
        </div>
        {mockCaption && <p class="mock-caption">{mockCaption}</p>}
      </div>
    </div>
  </div>

  <div class="scrollcue mono">scroll ↓</div>
</header>

<style>
  .hero-product {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  /* dawn — biased toward the product column */
  .dawn {
    position: absolute;
    left: 58%;
    bottom: -22vh;
    transform: translateX(-50%) scale(0.65);
    width: min(120vw, 1400px);
    height: 110vh;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(243, 189, 118, 0.48) 0%,
      rgba(232, 145, 124, 0.28) 30%,
      rgba(197, 106, 110, 0.12) 50%,
      rgba(197, 106, 110, 0) 72%
    );
    filter: blur(10px);
    opacity: 0;
    animation:
      rise 2.8s cubic-bezier(0.16, 0.7, 0.2, 1) 0.2s forwards,
      drift 14s ease-in-out 3s infinite alternate;
    pointer-events: none;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }
  @keyframes drift {
    from {
      transform: translateX(-50%) scale(1);
    }
    to {
      transform: translateX(-54%) scale(1.05);
    }
  }

  /* keeps copy readable when mock bleeds on wide screens */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      var(--ink) 0%,
      var(--veil-strong) 38%,
      var(--veil-soft) 58%,
      var(--veil-fade) 72%
    );
    opacity: 0;
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @keyframes up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-shell {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(88px, 12vh, 120px) clamp(20px, 4vw, 48px)
      clamp(56px, 8vh, 80px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(340px, 1.08fr);
    gap: clamp(20px, 3.5vw, 48px);
    align-items: center;
  }

  .hero-copy {
    text-align: left;
    max-width: 36rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 20px;
    opacity: 0;
    animation: up 0.9s ease 0.3s forwards;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(38px, 4.8vw, 76px);
    line-height: 0.98;
    letter-spacing: -1.2px;
    margin: 0 0 20px;
  }
  h1 .l {
    display: block;
    opacity: 0;
    transform: translateY(22px);
    animation: up 1.1s cubic-bezier(0.16, 0.7, 0.2, 1) forwards;
  }
  h1 .l:nth-child(1) {
    animation-delay: 0.5s;
  }
  h1 .l:nth-child(2) {
    animation-delay: 0.65s;
  }
  h1 :global(em) {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(
      100deg,
      var(--dawn-1),
      var(--dawn-2) 60%,
      var(--dawn-3)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sub {
    font-size: clamp(15px, 1.5vw, 18px);
    color: var(--paper-dim);
    max-width: 42ch;
    margin: 0 0 22px;
    font-weight: 300;
    line-height: 1.55;
    opacity: 0;
    animation: up 1s ease 0.85s forwards;
  }

  .verse {
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 28px;
    opacity: 0;
    animation: up 1s ease 1s forwards;
    letter-spacing: 0.2px;
  }
  .actions {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: up 1s ease 1.15s forwards;
  }

  .cta-note {
    margin: 14px 0 0;
    font-size: 13.5px;
    color: var(--muted);
    font-weight: 300;
    opacity: 0;
    animation: up 1s ease 1.25s forwards;
  }
  .cta-note .macos-link {
    color: var(--paper-dim);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.25s, border-color 0.25s;
  }
  .cta-note .macos-link:hover {
    color: var(--paper);
    border-bottom-color: var(--border-strong);
  }

  .hero-visual {
    position: relative;
    min-width: 0;
  }

  .hero-mock {
    position: relative;
    width: calc(100% + clamp(0px, 6vw, 72px));
    margin-right: calc(-1 * clamp(0px, 6vw, 72px));
    opacity: 0;
    transform: translateY(20px) perspective(1200px) rotateY(-4deg);
    transform-origin: center left;
    animation: mock-in 1.3s cubic-bezier(0.16, 0.7, 0.2, 1) 1.1s forwards;
    filter: drop-shadow(0 40px 80px var(--shadow));
  }
  @keyframes mock-in {
    to {
      opacity: 1;
      transform: translateY(0) perspective(1200px) rotateY(-2deg);
    }
  }

  .hero-mock :global(.hero-appw) {
    min-height: clamp(380px, 52vh, 520px);
  }
  .hero-mock :global(.hero-appw .appw-main) {
    min-height: inherit;
  }
  .hero-mock :global(.hero-appw .editor) {
    flex: 1;
  }

  .mock-caption {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(15px, 1.6vw, 19px);
    color: var(--muted);
    margin-top: 14px;
    padding-left: 4px;
    opacity: 0;
    animation: fade 1.2s ease 1.65s forwards;
  }

  .scrollcue {
    position: absolute;
    bottom: 20px;
    left: clamp(20px, 4vw, 48px);
    z-index: 3;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--muted);
    text-transform: uppercase;
    opacity: 0;
    animation: fade 1.5s ease 2.1s forwards;
  }

  /* wide: subtle overlap — mock feels expansive, copy stays on ink */
  @media (min-width: 1080px) {
    .hero-veil {
      opacity: 1;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(420px, 1.22fr);
    }
    .hero-visual {
      margin-top: 12px;
    }
  }

  @media (min-width: 1280px) {
    .hero-shell {
      max-width: 1440px;
    }
    .dawn {
      left: 62%;
      width: 100vw;
    }
  }

  /* stack: headline first, full-width product below */
  @media (max-width: 960px) {
    .hero-veil {
      opacity: 0;
    }

    .hero-product {
      min-height: auto;
      padding-bottom: 32px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-copy {
      text-align: center;
      max-width: none;
      margin: 0 auto;
    }

    h1 {
      font-size: clamp(36px, 9vw, 52px);
      max-width: 14ch;
      margin-left: auto;
      margin-right: auto;
    }

    .sub {
      margin-left: auto;
      margin-right: auto;
    }

    .actions {
      justify-content: center;
    }

    .cta-note {
      text-align: center;
    }

    /* Phone traffic must not be sent at a Mac .dmg. */
    .macos-only {
      display: none;
    }

    .hero-visual {
      margin: 0 auto;
      width: 100%;
      max-width: 520px;
    }

    .hero-mock {
      width: 100%;
      margin-right: 0;
      transform: translateY(16px);
      animation: mock-in-mobile 1.2s cubic-bezier(0.16, 0.7, 0.2, 1) 1s forwards;
    }
    @keyframes mock-in-mobile {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .mock-caption {
      text-align: center;
    }

    .dawn {
      left: 50%;
      bottom: 5vh;
    }

    .scrollcue {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  @media (max-width: 520px) {
    .hero-mock {
      width: 108%;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dawn {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
    .hero-veil {
      opacity: 1;
    }
    .eyebrow,
    h1,
    h1 .l,
    .sub,
    .verse,
    .actions,
    .cta-note,
    .hero-mock,
    .mock-caption,
    .scrollcue {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero-mock {
      filter: drop-shadow(0 40px 80px var(--shadow));
    }
  }
</style>

<script>
  const dawn = document.getElementById("dawn");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (dawn && !reduce) {
    addEventListener(
      "scroll",
      () => {
        dawn.style.marginBottom = window.scrollY * 0.12 + "px";
      },
      { passive: true },
    );
  }
</script>
