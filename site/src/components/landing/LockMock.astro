---
// App lock — the lock screen as it stands in front of a journal: the mark, a
// PIN row filling, and Face ID offered (src/features/applock/LockScreen.tsx).
---

<div class="lk" aria-hidden="true">
  <div class="lk-blur">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="lk-card">
    <svg class="lk-icon" viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2.5" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" /></svg>
    <div class="lk-t">Enter your PIN.</div>
    <div class="lk-dots"><i></i><i></i><i></i><i></i></div>
    <div class="lk-bio">
      <svg viewBox="0 0 24 24"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M9 10v1M15 10v1M12 10v3.5h-1M9.5 16.2c1.4 1 3.6 1 5 0" /></svg>
      Use Face ID
    </div>
  </div>
</div>

<style>
  .lk {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    aspect-ratio: 5 / 4;
    background: linear-gradient(175deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--border);
    box-shadow: 0 60px 120px -60px var(--shadow), 0 0 90px -40px var(--accent-glow);
    display: grid;
    place-items: center;
  }
  .lk-blur {
    position: absolute;
    inset: 0;
    padding: 40px 44px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    filter: blur(7px);
    opacity: 0.55;
  }
  .lk-blur span {
    height: 11px;
    border-radius: 6px;
    background: var(--border-strong);
  }
  .lk-blur span:nth-child(1) {
    width: 40%;
    height: 20px;
    margin-bottom: 10px;
  }
  .lk-blur span:nth-child(3) {
    width: 86%;
  }
  .lk-blur span:nth-child(5) {
    width: 62%;
  }
  .lk-card {
    position: relative;
    text-align: center;
    padding: 30px 40px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--ink-2) 80%, transparent);
    border: 1px solid var(--border);
    backdrop-filter: blur(6px);
  }
  .lk-icon,
  .lk-bio svg {
    fill: none;
    stroke: var(--dawn-1);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lk-icon {
    width: 30px;
    height: 30px;
    margin-bottom: 10px;
  }
  .lk-t {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--paper);
    margin-bottom: 18px;
  }
  .lk-dots {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-bottom: 22px;
  }
  .lk-dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid var(--dawn-1);
    animation: lkFill 4.8s infinite;
  }
  .lk-dots i:nth-child(2) {
    animation-delay: 0.35s;
  }
  .lk-dots i:nth-child(3) {
    animation-delay: 0.7s;
  }
  .lk-dots i:nth-child(4) {
    animation-delay: 1.05s;
  }
  @keyframes lkFill {
    0%,
    18% {
      background: transparent;
    }
    24%,
    70% {
      background: var(--dawn-1);
    }
    80%,
    100% {
      background: transparent;
    }
  }
  .lk-bio {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--paper-dim);
  }
  .lk-bio svg {
    width: 18px;
    height: 18px;
  }
  :global(.motion-off) .lk-dots i {
    animation: none;
    background: var(--dawn-1);
  }
</style>
