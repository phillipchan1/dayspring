---
// RitualsRail — the whole library in one sideways row. Not pinned to the
// page's scroll: swipe it, drag it, or use the arrows; the page keeps moving.
// Every card names where the form came from; the data is the /rituals page's,
// which rituals.test.ts keeps in step with the app's shelf.
import { rituals } from "../../content/rituals";
import { ritualsRail } from "../../content/landing";
const n = rituals.length;
---

<section class="rail" data-track="rituals" aria-labelledby="rail-h">
  <header class="r-head">
    <div>
      <div class="kicker">{ritualsRail.kicker} · {n} forms</div>
      <h2 id="rail-h" class="h2" set:html={ritualsRail.heading} />
    </div>
    <div class="r-side">
      <p class="body-l">{ritualsRail.lead}</p>
      <div class="r-ctrl">
        <a class="text-link" href={ritualsRail.more.href}>{ritualsRail.more.label} →</a>
        <span class="r-btns">
          <button type="button" class="r-btn" data-dir="-1" aria-label="Previous rituals">←</button>
          <button type="button" class="r-btn" data-dir="1" aria-label="More rituals">→</button>
        </span>
      </div>
    </div>
  </header>

  <div class="track" tabindex="0" aria-label="The ritual library">
    {
      rituals.map((r, i) => (
        <article class="card">
          <div class="c-top">
            <span class="c-n mono">{String(i + 1).padStart(2, "0")} / {n}</span>
            <span class="c-trad mono">{r.tradition}</span>
          </div>
          <h3 class="c-name">{r.name}</h3>
          <p class="c-quote">“{r.quote}”</p>
          <p class="c-origin mono">{r.origin}</p>
        </article>
      ))
    }
  </div>
  <div class="r-progress" aria-hidden="true"><span></span></div>
</section>

<style>
  .rail {
    padding: 10vh 0 12vh;
    --edge: max(24px, calc((100vw - 1280px) / 2));
  }
  .r-head {
    padding: 0 var(--edge);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 64px;
    align-items: end;
    margin-bottom: 44px;
  }
  .r-head .kicker {
    margin-bottom: 16px;
  }
  .r-head .h2 {
    max-width: 14ch;
  }
  .r-ctrl {
    margin-top: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .r-btns {
    display: flex;
    gap: 8px;
  }
  .r-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--paper);
    font-size: 16px;
    cursor: default;
    transition: border-color 0.3s, opacity 0.3s;
  }
  .r-btn:active {
    opacity: 0.6;
  }
  @media (hover: hover) {
    .r-btn:hover {
      border-color: var(--dawn-1);
    }
  }

  .track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    padding: 10px var(--edge) 30px;
    scroll-padding-left: var(--edge);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    cursor: grab;
    user-select: none;
  }
  .track.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: none;
  }
  .card {
    flex: none;
    scroll-snap-align: start;
    width: 320px;
    min-height: 420px;
    padding: 26px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: linear-gradient(170deg, var(--ink-3), var(--ink-2));
    display: flex;
    flex-direction: column;
    box-shadow: 0 40px 80px -50px var(--shadow);
    transition: border-color 0.4s, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  .card::after {
    content: "";
    position: absolute;
    inset: auto -30% -50% -30%;
    height: 70%;
    background: radial-gradient(closest-side, var(--accent-glow), transparent);
    opacity: 0;
    transition: opacity 0.5s;
  }
  @media (hover: hover) {
    .card:hover {
      border-color: var(--border-strong);
      transform: translateY(-6px);
    }
    .card:hover::after {
      opacity: 1;
    }
  }
  .c-top {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: auto;
  }
  .c-trad {
    color: var(--dawn-1);
    letter-spacing: 0.6px;
  }
  .c-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 36px;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 80px 0 18px;
  }
  .c-quote {
    font-style: italic;
    font-size: 18px;
    line-height: 1.45;
    color: var(--paper-dim);
    margin-bottom: 22px;
  }
  .c-origin {
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
    border-top: 1px solid var(--border-dim);
    padding-top: 14px;
  }
  .r-progress {
    margin: 0 var(--edge);
    height: 1px;
    background: var(--border);
    position: relative;
  }
  .r-progress span {
    position: absolute;
    inset: 0;
    background: var(--dawn-1);
    transform-origin: left;
    transform: scaleX(0.1);
  }

  @media (max-width: 900px) {
    .r-head {
      grid-template-columns: 1fr;
      margin-bottom: 26px;
    }
    .r-btns {
      display: none;
    }
    .card {
      width: 78vw;
      min-height: 380px;
    }
  }
</style>

<script>
  import { boot, gsap, reduced } from "../../lib/motion";
  boot();

  const section = document.querySelector<HTMLElement>(".rail");
  const track = section?.querySelector<HTMLElement>(".track");
  if (section && track) {
    const bar = section.querySelector<HTMLElement>(".r-progress span")!;
    const step = () => (track.querySelector<HTMLElement>(".card")?.offsetWidth ?? 320) + 18;
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      const p = max > 0 ? track.scrollLeft / max : 1;
      bar.style.transform = `scaleX(${0.1 + 0.9 * p})`;
    };
    track.addEventListener("scroll", sync, { passive: true });
    sync();

    section.querySelectorAll<HTMLButtonElement>(".r-btn").forEach((b) =>
      b.addEventListener("click", () =>
        track.scrollBy({ left: Number(b.dataset.dir) * step() * 2, behavior: reduced ? "auto" : "smooth" }),
      ),
    );

    // drag to scroll with a mouse (touch already swipes natively)
    let down = false;
    let startX = 0;
    let startLeft = 0;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      down = true;
      startX = e.clientX;
      startLeft = track.scrollLeft;
      track.classList.add("dragging");
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener("pointermove", (e) => {
      if (down) track.scrollLeft = startLeft - (e.clientX - startX);
    });
    const up = () => {
      if (!down) return;
      down = false;
      track.classList.remove("dragging");
    };
    track.addEventListener("pointerup", up);
    track.addEventListener("pointercancel", up);

    if (!reduced) {
      gsap.from(".rail .card", {
        x: 80,
        opacity: 0,
        rotateY: -14,
        transformPerspective: 900,
        stagger: 0.06,
        duration: 1.1,
        ease: "expo.out",
        scrollTrigger: { trigger: track, start: "top 85%" },
      });
      gsap.from(".r-head > *", {
        y: 40,
        opacity: 0,
        stagger: 0.1,
        duration: 1.1,
        ease: "power3.out",
        scrollTrigger: { trigger: ".r-head", start: "top 80%" },
      });
    }
  }
</script>
