---
// History — bring your journal with you. Three sources flow into one count,
// and the first look back is ready on day one.
import { history as h } from "../../content/landing";
---

<section class="history" data-track="history" aria-labelledby="hist-h">
  <div class="hi-inner">
    <div class="hi-copy">
      <div class="kicker">{h.kicker}</div>
      <h2 id="hist-h" class="h2" set:html={h.heading} />
      <p class="body-l">{h.lead}</p>
    </div>

    <div class="flow" aria-hidden="true">
      <div class="srcs">
        {h.sources.map((s) => <span class="src mono">{s}</span>)}
      </div>
      <svg class="streams" viewBox="0 0 400 160" preserveAspectRatio="none">
        <path d="M60 0 C60 80, 200 70, 200 160" />
        <path d="M200 0 C200 60, 200 100, 200 160" />
        <path d="M340 0 C340 80, 200 70, 200 160" />
      </svg>
      <div class="count-card">
        <div class="count display" data-to={h.count}>0</div>
        <div class="count-l mono">{h.countLabel}</div>
        <div class="ready">{h.ready}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .history {
    padding: 20vh 24px;
  }
  .hi-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 6vw, 100px);
    align-items: center;
  }
  .hi-copy .kicker {
    margin-bottom: 16px;
  }
  .hi-copy .h2 {
    margin-bottom: 22px;
  }
  .flow {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .srcs {
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 440px;
  }
  .src {
    font-size: 12px;
    padding: 9px 16px;
    border-radius: 100px;
    border: 1px solid var(--border-strong);
    color: var(--paper-dim);
    background: var(--surface);
  }
  .streams {
    width: 100%;
    max-width: 400px;
    height: 140px;
    fill: none;
    stroke: var(--dawn-1);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    overflow: visible;
  }
  .streams path {
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 4 6;
    animation: flow 1.2s linear infinite;
    opacity: 0.7;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -20;
    }
  }
  .count-card {
    width: min(400px, 100%);
    text-align: center;
    padding: 34px 30px;
    border-radius: 20px;
    background: linear-gradient(170deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--border);
    box-shadow:
      0 50px 100px -50px var(--shadow),
      0 0 80px -30px var(--accent-glow);
  }
  .count {
    font-size: clamp(56px, 6vw, 88px);
    color: var(--gold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .count-l {
    font-size: 11px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--muted);
    margin: 10px 0 18px;
  }
  .ready {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 22px;
  }
  @media (max-width: 900px) {
    .hi-inner {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { boot, gsap, reduced } from "../../lib/motion";
  boot();

  const el = document.querySelector<HTMLElement>(".history .count");
  if (el) {
    const to = Number(el.dataset.to ?? 0);
    const fmt = (n: number) => Math.round(n).toLocaleString("en-US");
    if (reduced) {
      el.textContent = fmt(to);
    } else {
      const o = { n: 0 };
      gsap.from(".history .hi-copy > *", {
        y: 40,
        opacity: 0,
        stagger: 0.1,
        duration: 1.1,
        ease: "power3.out",
        scrollTrigger: { trigger: ".history", start: "top 70%" },
      });
      gsap.from(".history .src", {
        y: -30,
        opacity: 0,
        stagger: 0.12,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: { trigger: ".history .flow", start: "top 75%" },
      });
      gsap.to(o, {
        n: to,
        duration: 2.4,
        ease: "power2.out",
        onUpdate: () => (el.textContent = fmt(o.n)),
        scrollTrigger: { trigger: ".history .count-card", start: "top 85%" },
      });
      gsap.from(".history .ready", {
        opacity: 0,
        y: 12,
        duration: 1,
        delay: 2.2,
        scrollTrigger: { trigger: ".history .count-card", start: "top 85%" },
      });
    }
  }
</script>
