---
// VoicePicker — the editor in each of its six voices, switchable.
//
// Every image is a real capture of the shipped editor (`npm run
// screenshots:site` → voice-<id>-<mode>.png), so this is a preview in the
// literal sense: pick Vellum and you are looking at what Vellum does to a page.
// Deliberately independent of the SITE's light/dark toggle — a voice IS a
// palette, and forcing Dawn-light onto an ink page would be the one thing the
// picker exists to let you choose.
//
// No framework: one <img> whose src/srcset swap on click. Works with JS off as
// a static Dawn-light shot.
import { voices } from "../content/features";

const first = voices[0];
const shot = (id: string, mode: string) => `/screenshots/voice-${id}-${mode}`;
---

<div class="vp" data-voice-picker>
  <div class="vp-controls">
    <div class="vp-voices" role="radiogroup" aria-label="Voice">
      {
        voices.map((v, i) => (
          <button
            type="button"
            role="radio"
            class="vp-chip"
            aria-checked={i === 0 ? "true" : "false"}
            data-voice={v.id}
            data-label={v.label}
            data-blurb={v.blurb}
            data-modes={v.modes.join(",")}
          >
            <span class="vp-dot" style={`background:${v.swatch}`} aria-hidden="true" />
            {v.label}
          </button>
        ))
      }
    </div>
    <div class="vp-modes" role="radiogroup" aria-label="Light or dark">
      <button type="button" role="radio" class="vp-mode" aria-checked="true" data-mode="light">Light</button>
      <button type="button" role="radio" class="vp-mode" aria-checked="false" data-mode="dark">Dark</button>
    </div>
  </div>

  <figure class="vp-frame">
    <div class="vp-chrome" aria-hidden="true"><i></i><i></i><i></i></div>
    <img
      class="vp-img"
      src={`${shot(first.id, "light")}.png`}
      srcset={`${shot(first.id, "light")}.png 1x, ${shot(first.id, "light")}@2x.png 2x`}
      width="800"
      height="700"
      alt={`The Dayspring editor in the ${first.label} voice, light.`}
      loading="lazy"
      decoding="async"
    />
  </figure>
  <p class="vp-blurb"><strong class="vp-name">{first.label}</strong> — <span class="vp-text">{first.blurb}</span></p>
</div>

<style>
  .vp {
    max-width: 820px;
    margin: 0 auto;
  }
  .vp-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .vp-voices,
  .vp-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .vp-chip,
  .vp-mode {
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--paper-dim);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 7px 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .vp-chip:hover,
  .vp-mode:hover {
    color: var(--paper);
    border-color: var(--border-strong);
  }
  .vp-chip[aria-checked="true"],
  .vp-mode[aria-checked="true"] {
    color: var(--paper);
    border-color: var(--dawn-1);
    background: var(--accent-glow);
  }
  .vp-mode[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .vp-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .vp-frame {
    margin: 0;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 50px 100px -50px var(--shadow),
      0 0 80px -45px var(--accent-glow);
  }
  .vp-chrome {
    display: flex;
    gap: 7px;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    background: var(--ink-3);
    border-bottom: 1px solid var(--border);
  }
  .vp-chrome i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0.65;
  }
  .vp-chrome i:nth-child(1) { background: #e8917c; }
  .vp-chrome i:nth-child(2) { background: #f3bd76; }
  .vp-chrome i:nth-child(3) { background: #9fcf8f; }
  .vp-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .vp-blurb {
    margin-top: 14px;
    text-align: center;
    font-style: italic;
    color: var(--muted);
    font-size: 15.5px;
  }
  .vp-name {
    font-style: normal;
    font-weight: 500;
    color: var(--paper-dim);
  }

  @media (max-width: 640px) {
    .vp-controls {
      justify-content: flex-start;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-voice-picker]").forEach((root) => {
    const img = root.querySelector<HTMLImageElement>(".vp-img")!;
    const name = root.querySelector<HTMLElement>(".vp-name")!;
    const text = root.querySelector<HTMLElement>(".vp-text")!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>(".vp-chip")];
    const modes = [...root.querySelectorAll<HTMLButtonElement>(".vp-mode")];
    let voice = chips[0];
    let mode = "light";

    const render = () => {
      const available = (voice.dataset.modes || "").split(",");
      // Vigil has no light palette: fall to dark and grey the Light button.
      if (!available.includes(mode)) mode = available[0];
      modes.forEach((m) => {
        m.disabled = !available.includes(m.dataset.mode!);
        m.setAttribute("aria-checked", String(m.dataset.mode === mode));
      });
      chips.forEach((c) => c.setAttribute("aria-checked", String(c === voice)));
      const base = `/screenshots/voice-${voice.dataset.voice}-${mode}`;
      img.srcset = `${base}.png 1x, ${base}@2x.png 2x`;
      img.src = `${base}.png`;
      img.alt = `The Dayspring editor in the ${voice.dataset.label} voice, ${mode}.`;
      name.textContent = voice.dataset.label!;
      text.textContent = voice.dataset.blurb!;
    };

    chips.forEach((c) =>
      c.addEventListener("click", () => {
        voice = c;
        render();
      }),
    );
    modes.forEach((m) =>
      m.addEventListener("click", () => {
        if (m.disabled) return;
        mode = m.dataset.mode!;
        render();
      }),
    );
  });
</script>
