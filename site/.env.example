# Dayspring marketing + help site
#
# Copy to `.env.local` for development. In production these live in the
# dayspring-site Vercel project's environment variables.
#
# NOTHING here is required to build the site. They only affect /help/contact —
# and if none of them are set, the form returns a visible error telling people
# to email hello@usedayspring.app directly. It never silently swallows a
# message.

# ---------------------------------------------------------------------------
# Delivery — pick ONE. The endpoint prefers Resend when both are present.
# ---------------------------------------------------------------------------

# Option A — Resend (recommended).
#
# Works with NO DNS setup: sign up with hello@usedayspring.app, and a brand-new
# account can send from `onboarding@resend.dev` to that same address straight
# away. Verifying usedayspring.app later unlocks a From address on your own
# domain and the auto-reply to visitors (see CONTACT_AUTOREPLY below).
RESEND_API_KEY=

# Option B — GitHub Issues. No mail service and no new account: each message
# becomes an issue and GitHub emails you about it. Both must be set. This is the
# same mechanism the app already uses for beta feedback (api/feedback.ts), so
# the app's existing GITHUB_TOKEN works here as-is.
#
# The repo MUST be private — issues carry the sender's email address and
# whatever they wrote. phillipchan1/dayspring is private and has Issues on.
GITHUB_TOKEN=
SUPPORT_REPO=phillipchan1/dayspring

# Label applied to filed issues. If the repo doesn't have this label the issue
# is filed WITHOUT it rather than failing — a label is filing convenience, and
# no amount of it is worth dropping a message someone wrote.
SUPPORT_LABEL=support

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------

# Where support messages land. Defaults to hello@usedayspring.app.
CONTACT_TO_EMAIL=hello@usedayspring.app

# The From address. Defaults to Resend's shared sender, which needs no DNS.
# Change to "Dayspring <support@usedayspring.app>" ONLY after verifying the
# domain in Resend — an unverified domain is rejected outright.
CONTACT_FROM_EMAIL=

# Send the visitor a confirmation that their message arrived. Requires a
# verified sending domain, because it sends to an arbitrary address. Leave
# unset until the domain is verified. Failures here never block the real
# message; they're logged and the submission still succeeds.
CONTACT_AUTOREPLY=

# ---------------------------------------------------------------------------
# Spam
# ---------------------------------------------------------------------------
# Three layers work with NO configuration at all:
#   - a honeypot field, hidden from people and irresistible to bots
#   - a timing check, rejecting anything filled faster than a person could type
#   - a per-instance rate limit, 5 per minute per IP
#
# Turnstile is the fourth and the only one that stops a determined bot. It's
# Cloudflare's CAPTCHA alternative — usually invisible, no puzzles. Free.
#
#   1. dash.cloudflare.com -> Turnstile -> Add widget
#   2. Domain: usedayspring.app   Mode: Managed
#   3. Put the site key and secret key below (and in Vercel)
#
# Leave both blank and the check is skipped entirely, so local development and
# an unconfigured deploy both work.
#
# Cloudflare's test keys, for exercising both branches without an account:
#   always passes: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
#   always fails:  2x00000000000000000000AB / 2x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
