{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayspring",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  // Static Vite build. Deep links fall back to index.html (same as Vercel SPA).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  // BETTER_AUTH_URL and ENVIRONMENT are not set here — wrangler vars ship to prod.
  // Local (`.dev.vars`): ENVIRONMENT=local and optionally BETTER_AUTH_URL=http://localhost:8787.
  // ENVIRONMENT=local (or a DB/Hyperdrive hostname that is exactly loopback) is
  // the only unset-URL fallback. Preview/prod: omit ENVIRONMENT and set
  // BETTER_AUTH_URL to the public Worker origin (docs/cloudflare-migration/cutover.md).
  "vars": {
    "OPENAI_MODEL": "gpt-5.4-nano",
    "RESEND_FROM": "Dayspring <hello@usedayspring.app>",
    "WELCOME_DRIP_SENDS_ENABLED": "false",
  },
  // Replace `id` with a real Hyperdrive config before any paid deploy.
  // Hyperdrive is a Workers Paid feature. Local / Free preview uses DATABASE_URL.
  // Local `wrangler dev` uses localConnectionString (or DATABASE_URL in .dev.vars).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/dayspring",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // workers.dev only. No routes, no custom domain. Do not deploy from CI.
  "env": {
    "preview": {
      "name": "dayspring-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "OPENAI_MODEL": "gpt-5.4-nano",
        "RESEND_FROM": "Dayspring <hello@usedayspring.app>",
        "WELCOME_DRIP_SENDS_ENABLED": "false",
        "BETTER_AUTH_URL": "https://dayspring-preview.nq-morning-briefing.workers.dev",
      },
      // Empty on purpose: Hyperdrive is not inherited. Preview uses DATABASE_URL.
      // A placeholder id here fails deploy with error 10157.
      "hyperdrive": [],
    },
  },
}
