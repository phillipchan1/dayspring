{
  "name": "Dayspring",
  "short_name": "Dayspring",
  "description": "Personal AI Journal — single-user, private journaling.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#1b1e27",
