<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dayspring uses the microphone to transcribe voice journal entries.</string>
	<key>NSCameraUsageDescription</key>
	<string>Dayspring uses the camera to scan handwritten journal pages.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Dayspring lets you attach photos from your library to journal entries.</string>
	<!-- Only reached when the user has turned on the optional app lock AND opted
	     into biometrics; the PIN always remains a way in. Required whenever the
	     app links LocalAuthentication, even if it never calls it. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID opens your journal without typing your PIN.</string>
	<!-- Still false with the app lock shipped. The lock derives a PBKDF2
	     verifier through the OS-provided WebCrypto implementation and uses it
	     solely to authenticate the person holding the device, which is within
	     Apple's exemption. Re-confirm at submission rather than assuming. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.phillipchan.dayspring</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dayspring</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
