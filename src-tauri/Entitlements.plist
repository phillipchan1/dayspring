<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac app ships with the hardened runtime, which blocks CoreLocation
	     outright unless this is granted. Without it the prompt never appears and
	     every page is saved with its hour and nothing else. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
