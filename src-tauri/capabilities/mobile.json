{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "iOS/Android permissions (StoreKit IAP + biometrics + shared defaults)",
  "platforms": ["iOS", "android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:default",
    "store:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-delete",
    "deep-link:default",
    "deep-link:allow-get-current",
    "opener:default",
    "opener:allow-open-url",
    "purchases:default",
    "biometric:default"
  ]
}
