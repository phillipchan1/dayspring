# Copy this file to .env.local and fill in the values from your own Supabase project.
# .env.local is gitignored — real keys never get committed.

# Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key (Project Settings → API → Project API keys → anon public)
# Safe to expose in a client; row access is still gated by Supabase Auth + per-row RLS.
VITE_SUPABASE_ANON_KEY=

# Optional — absolute origin for /api/* calls from the Tauri desktop app.
# Defaults to https://dayspring-eosin.vercel.app when running inside the desktop shell.
# For local desktop dev against `vercel dev`, set to http://localhost:3000.
# VITE_API_BASE_URL=

# ── Server-only (Reflections synthesis job) ────────────────────────────────
# These are NOT VITE_-prefixed, so Vite never bundles them into the client.
# Set them in Vercel → Project Settings → Environment Variables. For local
# `vercel dev` testing, add them to .env (gitignored). NEVER import from src/.

# Mirrors the Supabase project URL above (without the VITE_ prefix).
SUPABASE_URL=

# Project Settings → API → service_role key. SECRET — bypasses RLS. Server only.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Crossway ESV API token. Register a (noncommercial) app at https://api.esv.org/
# and paste the token here. Resolves verbatim ESV verse text; server only.
ESV_API_KEY=

# Random string guarding /api/cron/* and /api/reflections/* (Bearer token).
CRON_SECRET=

# ── Beta feedback widget ───────────────────────────────────────────────────
# GitHub PAT (Settings → Developer settings → Fine-grained tokens → repo: Issues write).
# Set in Vercel → Environment Variables. Server only.
GITHUB_TOKEN=

# Set to 'true' in Vercel to show the feedback button to beta users.
# Remove or set to anything else to hide it. Client-side feature flag.
VITE_BETA_FEEDBACK_ENABLED=

# ── Usage measurement (PostHog) ─────────────────────────────────────────────
# Project Settings → Project API Key. Unset → the SDK is never loaded and events
# stay a dev-console no-op. See lib/analytics.ts for the vocabulary and the
# privacy guarantee (enum/number/boolean props only — no free text, ever) and
# docs/product/MEASUREMENT.md for what we do and don't track.
#
# There is no host variable. The browser talks to /cairn on our own domain and
# vercel.json proxies it to PostHog — so the destination lives in one file
# instead of being baked into every desktop binary at build time.
#
# CLIENT (browser + desktop). Must ALSO be set in Vercel and in both release
# workflows, or desktop builds silently report nothing.
VITE_POSTHOG_KEY=
#
# SERVER (webhooks only — subscription lifecycle events, which no browser is
# present to witness). Same project API key; separate name because this one must
# never be inlined into the client bundle. Unset → server events are skipped.
POSTHOG_KEY=
# Override only for a non-US PostHog region. Defaults to https://us.i.posthog.com.
# POSTHOG_HOST=

# ── Onboarding trial model ─────────────────────────────────────────────────
# Default (unset/false): app-managed reverse trial — the 14-day trial is granted
# in Supabase at first sign-in (no Stripe, no card) and the welcome + import flow
# runs inside it. Set both to 'true' for card-first: a Stripe Checkout step is
# inserted between sign-in and Welcome. Keep the two in sync.
# NEVER enable card-first on iOS builds — App Store requires StoreKit IAP.
# ONBOARDING_REQUIRE_CARD=          # server (api/_lib/env.ts)
# VITE_ONBOARDING_REQUIRE_CARD=     # client (src/features/onboarding/flags.ts)

# ── Apple In-App Purchase (iOS / TestFlight) ───────────────────────────────
# App Store Connect → Users and Access → Integrations → In-App Purchase key.
# See docs/IOS.md. Required for /api/apple/verify and /api/webhooks/apple.
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_APP_APPLE_ID=
# APPLE_BUNDLE_ID=com.phillipchan.dayspring
# Optional product id overrides (client, baked at Vite build time):
# VITE_APPLE_IAP_MONTHLY_PRODUCT_ID=dayspring_monthly
# VITE_APPLE_IAP_ANNUAL_PRODUCT_ID=dayspring_annual
# Optional RevenueCat webhook (prefer first-party Apple ASN above):
# REVENUECAT_WEBHOOK_SECRET=
